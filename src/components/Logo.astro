---
/**
 * Brand mark — "Aperture": three translucent discs overlapping in a triangle,
 * so the intersections read as gathered light (option 2 of the abstract set,
 * Anish's pick). Original geometry on a 32-unit grid.
 *
 * The discs are `currentColor` at 0.62 alpha; where they overlap, source-over
 * compositing brightens the intersection — that layering is the mark. It
 * flattens gracefully to near-solid at favicon sizes.
 *
 * Geometry is duplicated in `public/favicon.svg`, `public/icon.svg` and
 * `scripts/generate-icons.mjs` (which rasterises the PNG/OG slots) — change one,
 * change all.
 */

interface Props {
  /** Rendered size in px. */
  size?: number;
  class?: string;
}

const { size = 28, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <circle cx="16" cy="10.5" r="7.5" fill="currentColor" opacity="0.62"></circle>
  <circle cx="11" cy="19" r="7.5" fill="currentColor" opacity="0.62"></circle>
  <circle cx="21" cy="19" r="7.5" fill="currentColor" opacity="0.62"></circle>
</svg>
