---
import Logo from './Logo.astro';
import { APPS, COPYRIGHT_YEAR } from '../lib/site';

/**
 * A single blue panel bar: mark, links, copyright, theme toggle.
 * The app links are generated from APPS, so a third app needs no edit here.
 */
const links = [
  ...APPS.map((app) => ({ label: app.name, href: `/${app.slug}` })),
  { label: 'Support', href: '/support' },
  { label: 'Delete account', href: '/delete-account' },
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
];
---

<footer class="foot shell">
  <div class="panel panel-blue foot-panel">
    <div class="foot-top">
      <a href="/" class="brand" aria-label="HSR Utility — home">
        <Logo size={30} class="brand-mark" />
      </a>

      <nav class="foot-links" aria-label="Footer">
        {links.map((link) => <a href={link.href} class="foot-link">{link.label}</a>)}
      </nav>

      <div class="foot-end">
        <p class="foot-copy">© {COPYRIGHT_YEAR} HSR Utility</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(4rem, 3rem + 5vw, 8rem);
    padding-bottom: clamp(1rem, 3vw, 2.5rem);
  }

  .foot-panel {
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 3rem);
  }

  .foot-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .brand {
    display: inline-flex;
    color: var(--text);
    flex-shrink: 0;
  }

  /* :global() — the mark is <Logo>'s root and carries Logo's scope id, not ours. */
  .brand :global(.brand-mark) {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (hover: hover) {
    .brand:hover :global(.brand-mark) {
      transform: scale(1.08);
    }
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.35rem;
  }

  .foot-link {
    /* Keeps the tap target near 44px without visually padding a sparse row. */
    padding: 0.5rem 0.7rem;
    border-radius: 0.5rem;
    /* Full white, not the muted periwinkle — links on the blue slab have to
       read at a glance. */
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.18s ease,
      opacity 0.18s ease;
  }

  .foot-link:hover {
    background: var(--accent-wash);
  }

  .foot-end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
  }

  .foot-copy {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .foot-top {
      align-items: flex-start;
    }
    .foot-end {
      margin-left: 0;
      flex-basis: 100%;
      justify-content: space-between;
    }
  }
</style>
