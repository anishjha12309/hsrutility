---
import DocLayout from '../../layouts/DocLayout.astro';
import Email from '../../components/Email.astro';
import LegalContact from '../../components/LegalContact.astro';
import LegalFootLinks from '../../components/LegalFootLinks.astro';
import {
  wallpaperApps,
  LEGAL_NAME,
  MONTHLY_PRICE,
  MANDATE_VERIFY_AMOUNT,
  PAYMENT_PROVIDER,
  legalPath,
  type WallpaperApp,
} from '../../lib/site';
import { organizationSchema, websiteSchema, breadcrumbSchema, webPageSchema } from '../../lib/schema';

/**
 * Refund & cancellation policy, one per app. Strictly no-refund, set by the owner on
 * 2026-08-20. Condensed the same day — shorter wording, identical position.
 *
 * Two things keep the refusal from reading as a trap, and both have to stay:
 *
 *  - The cancellation route comes FIRST, before the refusal. A no-refund policy is
 *    only fair if stopping the charges is easy and obvious.
 *  - The ₹2 mandate verification is named and explained. The bank reverses it, so it
 *    is not a refund case at all — but the user watches it leave their account, and
 *    an unexplained debit on a page about refunds is the worst possible place for a
 *    gap.
 *
 * Billing is a PhonePe UPI Autopay mandate, NOT Google Play. Anyone assuming Play
 * billing will hunt for a Play refund button, fail to find one, and file a
 * chargeback — so the page says so outright.
 */
// Wallpaper apps only: an app without `legal` (AlertPaisa) has its own page under
// src/pages/<slug>/, and this template's wording would be wrong for it.
export function getStaticPaths() {
  return wallpaperApps().map((app) => ({ params: { app: app.slug }, props: { app } }));
}

interface Props {
  app: WallpaperApp;
}

const { app } = Astro.props;
const lastUpdated = 'August 2026';

const description = `Refund and cancellation policy for ${app.name}: how to cancel a premium subscription, what happens to access afterwards, and our no-refund position on payments already taken.`;

const structuredData = [
  organizationSchema,
  websiteSchema,
  breadcrumbSchema([{ name: app.name, path: `/${app.slug}` }, { name: 'Refund Policy' }]),
  webPageSchema({
    path: legalPath(app, 'refund-policy'),
    name: `Refund Policy — ${app.name} | HSR Utility`,
    description,
  }),
];

const noRefundFor = [
  'A change of mind after subscribing.',
  'The unused part of a period you have paid for.',
  'Cancelling partway through a period — nothing is pro-rated.',
  'Forgetting to cancel before a renewal.',
  'Not using the app, or not using what premium unlocked.',
  'Finding another app you prefer.',
  'Content already applied, set or downloaded.',
  'An account terminated for breaking our Terms.',
  'Deleting your account, which ends access at once and forfeits the rest of the period.',
];
---

<DocLayout
  title={`Refund Policy — ${app.name}`}
  heading="Refund &amp; Cancellation Policy"
  eyebrow={`${app.name} — legal`}
  description={description}
  lastUpdated={lastUpdated}
  structuredData={structuredData}
  scope={app}
  intro="Cancelling is immediate and costs nothing. Payments already taken are not refunded — please read this before you subscribe."
>
  <section>
    <p>
      Premium subscriptions to <strong>{app.name}</strong> (package <code>{app.packageId}</code>),
      operated by <strong>{LEGAL_NAME}</strong>. It sits alongside the app's
      <a href={legalPath(app, 'terms')}>Terms &amp; Conditions</a>, which govern the subscription
      itself.
    </p>
  </section>

  <section>
    <h2 id="what-you-pay">1. What You Pay For</h2>
    <p>
      Browsing and previewing {app.legal.catalogue} is free, permanently. Premium unlocks applying
      and sharing wallpapers and setting ringtones, at <strong>{MONTHLY_PRICE} per month</strong>,
      renewing until you cancel.
    </p>
    <div class="doc-card">
      <p class="doc-card-title">UPI Autopay, not the Google Play Store</p>
      <p>
        The subscription is a UPI Autopay mandate you approve in your own UPI app, processed by
        {PAYMENT_PROVIDER}. It is not a Play in-app purchase, so it has no Play Store subscription
        entry and no Play refund route. Cancel in the app, as below.
      </p>
    </div>
    <div class="doc-card">
      <p class="doc-card-title">The {MANDATE_VERIFY_AMOUNT} verification is not a charge</p>
      <p>
        Setting up the mandate takes a {MANDATE_VERIFY_AMOUNT} debit that your bank reverses
        automatically — you will see it leave and come back. It authorises the mandate, is not the
        price of anything, and is not a refund matter. If the reversal has not landed after a few
        working days, email us and we will chase it.
      </p>
    </div>
  </section>

  <section>
    <h2 id="cancel">2. How to Cancel</h2>
    <p>Any time, without asking us or giving a reason:</p>
    <ul>
      <li>
        <strong>In the app</strong> — Settings → your plan → Cancel. This is the supported route and
        reaches us instantly.
      </li>
      <li>
        <strong>Or in your UPI app</strong> — a mandate can be paused or revoked under Autopay,
        Mandates or Subscriptions. That stops the debit at your bank, so tell us too if anything then
        looks wrong.
      </li>
    </ul>
    <p>
      Cancelling stops every future charge and leaves premium running until the end of the period you
      have already paid for; the app then returns to its free tier, which never expires.
    </p>
    <p>
      Cancelling is not deleting. <a href={legalPath(app, 'how-to-delete-account')}>Deleting your
      account</a> also ends premium immediately and forfeits whatever time was left.
    </p>
  </section>

  <section>
    <h2 id="no-refunds">3. No Refunds</h2>
    <p>
      <strong>
        Payments already taken are final and non-refundable, and cancelling does not refund them.
      </strong>
      No refund is given for:
    </p>
    <ul>{noRefundFor.map((item) => <li>{item}</li>)}</ul>
    <p>
      Subscribing is an acknowledgement of this. Browsing and previewing are free, and the trial is
      free once per person, precisely so you can judge the app before any money moves.
    </p>
    <p>
      Nothing here removes a right you hold under Indian consumer law that cannot be given up by
      agreement.
    </p>
  </section>

  <section>
    <h2 id="errors">4. Charges Taken in Error</h2>
    <p>
      A charge that should never have happened is not a refund request and is not treated as one.
      Charged twice for one period, charged after a cancellation went through, or charged an amount
      that does not match the paywall — send your registered email, the date and the amount to
      <Email /> and we will investigate and correct anything that proves to be our error.
    </p>
  </section>

  <section>
    <h2 id="disputes">5. Before You Raise a Dispute</h2>
    <p>
      Please come to us before raising a chargeback with your bank or UPI provider. A dispute runs for
      weeks and usually suspends the subscription while it does; an email usually gets an answer the
      same day. Disputes under this policy are governed by the laws of India and subject to the
      exclusive jurisdiction of the courts of Mumbai, Maharashtra.
    </p>
  </section>

  <section>
    <h2 id="changes">6. Changes</h2>
    <p>
      We may update this policy for legal, operational or regulatory reasons. The "Last updated" date
      moves when we do, and a significant change is announced in the app. No change ever applies
      retroactively to a payment already taken.
    </p>
  </section>

  <section>
    <h2 id="contact">7. Contact Us</h2>
    <LegalContact app={app} intro="Questions about this policy, a charge, or cancelling:" />
  </section>

  <LegalFootLinks app={app} current="refund-policy" />
</DocLayout>
