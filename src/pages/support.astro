---
import DocLayout from '../layouts/DocLayout.astro';
import Email from '../components/Email.astro';
import { fenceEmail } from '../lib/email';
import {
  SUPPORT_EMAIL,
  SUPPORT_PHONE,
  LEGAL_NAME,
  ADDRESS_LINES,
  AWAAZPAY,
  appNames,
  appNamesOr,
  wallpaperApps,
} from '../lib/site';
import {
  organizationSchema,
  websiteSchema,
  breadcrumbSchema,
  webPageSchema,
  faqPageSchema,
} from '../lib/schema';

/**
 * PORTED from the previous build. Three answers were factually stale and are corrected
 * against the app repos (the source of truth for app facts):
 *   - Arul is LIVE on Google Play (was: "both apps are being prepared").
 *   - Premium unlocks applying, setting ringtones and SHARING (was: "saving").
 *     Both app READMEs say sharing; saving was never the gated action.
 *   - The invented legal entity is gone, and "nasheeds" is now "ringtones".
 * Everything else is unchanged.
 *
 * AwaazPay added 17 Nov 2026: answers that described wallpaper features or the
 * wallpaper premium tier as true of every app are scoped to the wallpaper apps, and
 * AwaazPay's own line follows (facts from its Play listing and policies).
 */

const wallpaperNames = appNames(wallpaperApps());

const faqs = [
  {
    q: 'What is HSR Utility?',
    a: `HSR Utility is an indie Android studio. It builds apps for specific audiences: Arul, South Indian wallpapers; and ${AWAAZPAY.name}, a passbook of your bank payments with autopay and EMI reminders. The studio itself has no religious affiliation.`,
  },
  {
    q: 'What is Arul?',
    a: 'Arul offers South Indian devotional wallpapers and ringtones in a shorts-style feed, browsable across six collections (Amman, Ayyappan, Murugan, Perumal, Sivan and Temples), in six Indian languages. You can submit your own wallpaper from inside the app.',
  },
  {
    q: `What is ${AWAAZPAY.name}?`,
    a: `${AWAAZPAY.name} keeps track of your money without typing anything. It builds a passbook of your bank debits and credits from the transaction messages on your phone, finds your UPI autopays, EMIs, subscriptions and bills, and reminds you before each one is due. It can also announce each debit or credit aloud in your chosen voice language. It is available in English, Hindi, Bengali, Tamil, Telugu, Marathi, Gujarati, Kannada, Malayalam and Punjabi. It is not a bank, does not move money and does not give financial advice.`,
    link: { label: `Get ${AWAAZPAY.name} on Google Play`, href: AWAAZPAY.playUrl as string, external: true },
  },
  {
    q: 'Are the apps on the Google Play Store?',
    a: `Arul and ${AWAAZPAY.name} are live on Google Play now.`,
    link: { label: 'Get Arul on Google Play', href: 'https://play.google.com/store/apps/details?id=com.hsrutility.arul', external: true },
  },
  {
    q: 'Are the apps free?',
    a: `${wallpaperNames}: yes — browsing and previewing every wallpaper and ringtone is completely free. An optional premium plan unlocks applying and sharing wallpapers, and setting ringtones. Setting up the UPI AutoPay mandate involves a small verification debit (currently ₹2) that is reversed automatically. ${AWAAZPAY.name}: ${AWAAZPAY.pricing.body}`,
  },
  {
    q: 'How do I sign in?',
    a: 'Our apps use Sign in with Google. We only receive your name and email address to create your account — not your Google profile photo, and never a phone number or password.',
  },
  {
    q: 'How do I report a bug or request a feature?',
    a: `Email us at ${SUPPORT_EMAIL} and mention which app (${appNamesOr()}). We read every email and reply within 48 hours.`,
  },
  {
    q: 'How do I delete my account and data?',
    a: `You can delete your account and data instantly from inside any of our apps (${wallpaperNames}: ${wallpaperApps()[0].deletePath}; ${AWAAZPAY.name}: ${AWAAZPAY.deletePath}), or request it by email if you have already uninstalled. Our Delete My Account page has the full steps.`,
    link: { label: 'Go to Delete My Account', href: '/delete-account' },
  },
  {
    q: 'Which Android versions are supported?',
    a: `${wallpaperNames} ${wallpaperApps().length === 1 ? 'supports' : 'support'} Android 7.0 (Nougat) and above; ${AWAAZPAY.name} needs Android 8.0 (Oreo) or newer. We recommend keeping your device updated for the best experience.`,
  },
];

const description =
  `Answers to common questions about ${appNames()} — wallpapers, ringtones, payment tracking, sign-in, and account help — plus how to contact HSR Utility support. We reply within 48 hours.`;

const structuredData = [
  organizationSchema,
  websiteSchema,
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Support' }]),
  webPageSchema({
    path: '/support',
    name: `Support & FAQ — ${appNames()} | HSR Utility`,
    description,
  }),
  // Mirrors the visible Q&A above, verbatim — same array, so they cannot drift.
  faqPageSchema(faqs),
];
---

<DocLayout
  title={`Support & FAQ — ${appNames()}`}
  heading="Help &amp; Support"
  eyebrow="Support"
  description={description}
  intro="Quick answers to the questions we get most. If yours isn't here, email us — we reply within 48 hours."
  structuredData={structuredData}
>
  <section>
    <div class="doc-card support-cta">
      <div>
        <p class="doc-card-title">Request account &amp; data deletion</p>
        <p>Permanently delete your {appNamesOr()} account and associated data at any time.</p>
      </div>
      <a href="/delete-account" class="btn btn-ghost">
        Delete account
        <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>

  <section>
    <h2 id="faq">Frequently asked questions</h2>

    {/*
      Native <details>. A hand-rolled accordion would need JS for open/close state,
      keyboard handling and aria-expanded; the element gives all three for nothing,
      and the open animation is pure CSS (see the ::details-content rule below).
    */}
    <div class="faq">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-q">
            <span>{faq.q}</span>
            <span class="faq-mark" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none">
                <path d="M8 3.5v9M3.5 8h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </span>
          </summary>
          <div class="faq-a">
            <p set:html={fenceEmail(faq.a)} />
            {faq.link && (
              <p>
                <a
                  href={faq.link.href}
                  class="link"
                  {...(faq.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {faq.link.label}
                  {faq.link.external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section>
    <div class="doc-card support-close">
      <h2 id="contact" class="support-close-title">Still need help?</h2>
      <p>Email us and we'll get back to you within 48 hours. Support is by email only.</p>
      <p style="margin-top:1.5rem">
        <Email class="btn btn-primary" arrow />
      </p>
      <dl class="doc-meta" style="margin-top:1.75rem">
        <div>
          <dt>Company</dt>
          <dd>{LEGAL_NAME}</dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd>{SUPPORT_PHONE}</dd>
        </div>
        <div>
          <dt>Address</dt>
          <dd>
            {ADDRESS_LINES.map((line, i) => (
              <>{i > 0 && <br />}{line}</>
            ))}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <nav class="doc-foot-links" aria-label="Related pages">
    <a href="/privacy-policy" class="link">Privacy Policy</a>
    <a href="/terms" class="link">Terms of Service</a>
    <a href="/delete-account" class="link">Delete your account</a>
  </nav>
</DocLayout>

<style is:global>
  .support-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .faq {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    /* ≥44px tap target. */
    padding-block: 1.15rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    transition: color 0.18s ease;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:hover {
    color: var(--accent);
  }

  .faq-mark {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--muted);
    transition:
      transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .faq-mark svg {
    width: 11px;
    height: 11px;
  }

  .faq-item[open] .faq-mark {
    transform: rotate(135deg);
    color: var(--accent);
    border-color: var(--accent-soft);
  }

  .faq-a {
    padding-bottom: 1.25rem;
    padding-right: 2.5rem;
  }

  .faq-a p {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
  }

  .faq-a p:last-child {
    margin-bottom: 0;
  }

  /*
    Smooth open/close for <details>. `interpolate-size` is what lets height animate
    to `auto`, and `allow-discrete` keeps content-visibility from cutting the
    transition short. Browsers without support simply snap open — the correct
    degradation, since the content is identical either way.
  */
  @supports (interpolate-size: allow-keywords) {
    :root {
      interpolate-size: allow-keywords;
    }

    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        content-visibility 0.3s allow-discrete,
        opacity 0.25s ease;
    }

    .faq-item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  .support-close {
    text-align: center;
  }

  /* Centred as a block, left-aligned inside it — a label/value grid cannot be
     centre-aligned and still line up, and the postal address is long enough that
     the ragged edge reads as broken rather than as styling.

     No `:global()` here: this block is already `is:global`, and Astro passes the
     selector through verbatim rather than compiling it away, so the rule ships as
     invalid CSS and every browser drops the whole thing silently. */
  .support-close .doc-meta {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    text-align: left;
  }

  .support-close-title {
    margin-bottom: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
