---
import DocLayout from '../layouts/DocLayout.astro';
import { SUPPORT_EMAIL } from '../lib/site';
import {
  organizationSchema,
  websiteSchema,
  breadcrumbSchema,
  webPageSchema,
  faqPageSchema,
} from '../lib/schema';

/**
 * PORTED from the previous build. Three answers were factually stale and are corrected
 * against the app repos (the source of truth for app facts):
 *   - Arul is LIVE on Google Play (was: "both apps are being prepared").
 *   - Premium unlocks applying, setting ringtones and SHARING (was: "saving").
 *     Both app READMEs say sharing; saving was never the gated action.
 *   - The invented legal entity is gone, and "nasheeds" is now "ringtones".
 * Everything else is unchanged.
 */

const faqs = [
  {
    q: 'What is HSR Utility?',
    a: 'HSR Utility is an indie Android studio. It builds wallpaper and ringtone apps for specific cultural audiences: Pakiza, an Islamic lifestyle app, and Arul, South Indian wallpapers. The studio itself has no religious affiliation.',
  },
  {
    q: 'What are Pakiza and Arul?',
    a: 'Pakiza pairs a shorts-style feed of Islamic wallpapers — still images and live video — with a curated ringtone library and offline Jummah and Islamic-calendar reminders, in eleven Indian languages. Arul offers South Indian devotional wallpapers and ringtones in the same shorts-style feed, browsable across six collections (Amman, Ayyappan, Murugan, Perumal, Sivan and Temples), in six Indian languages. Both apps let you submit your own content from inside the app, and both have offline reminders. They are Android apps built by the same team.',
  },
  {
    q: 'Are the apps on the Google Play Store?',
    a: 'Arul is live on Google Play now. Pakiza is coming soon — email us at support@hsrutility.com and we will let you know when it goes live.',
    link: { label: 'Get Arul on Google Play', href: 'https://play.google.com/store/apps/details?id=com.hsrutility.arul', external: true },
  },
  {
    q: 'Are the apps free?',
    a: 'Yes — browsing and previewing every wallpaper and ringtone is completely free. An optional premium plan unlocks applying and sharing wallpapers, and setting ringtones. Setting up the UPI AutoPay mandate involves a small verification debit (currently ₹2) that is reversed automatically.',
  },
  {
    q: 'How do I sign in?',
    a: 'Our apps use Sign in with Google. We only receive your name and email address to create your account — not your Google profile photo, and never a phone number or password.',
  },
  {
    q: 'How do I report a bug or request a feature?',
    a: 'Email us at support@hsrutility.com and mention which app (Pakiza or Arul). We read every email and reply within 48 hours.',
  },
  {
    q: 'How do I delete my account and data?',
    a: 'You can delete your account and data instantly from inside either app (Settings → Delete account), or request it by email if you have already uninstalled. Our Delete My Account page has the full steps.',
    link: { label: 'Go to Delete My Account', href: '/delete-account' },
  },
  {
    q: 'Which Android versions are supported?',
    a: 'Both apps support Android 7.0 (Nougat) and above. We recommend keeping your device updated for the best experience.',
  },
];

const description =
  'Answers to common questions about Pakiza and Arul — wallpapers, ringtones, sign-in, and account help — plus how to contact HSR Utility support. We reply within 48 hours.';

const structuredData = [
  organizationSchema,
  websiteSchema,
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Support' }]),
  webPageSchema({
    path: '/support',
    name: 'Support & FAQ — Pakiza & Arul | HSR Utility',
    description,
  }),
  // Mirrors the visible Q&A above, verbatim — same array, so they cannot drift.
  faqPageSchema(faqs),
];
---

<DocLayout
  title="Support & FAQ — Pakiza & Arul"
  heading="Help &amp; Support"
  eyebrow="Support"
  description={description}
  intro="Quick answers to the questions we get most. If yours isn't here, email us — we reply within 48 hours."
  structuredData={structuredData}
>
  <section>
    <div class="doc-card support-cta">
      <div>
        <p class="doc-card-title">Request account &amp; data deletion</p>
        <p>Permanently delete your Pakiza or Arul account and associated data at any time.</p>
      </div>
      <a href="/delete-account" class="btn btn-ghost">
        Delete account
        <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>

  <section>
    <h2 id="faq">Frequently asked questions</h2>

    {/*
      Native <details>. A hand-rolled accordion would need JS for open/close state,
      keyboard handling and aria-expanded; the element gives all three for nothing,
      and the open animation is pure CSS (see the ::details-content rule below).
    */}
    <div class="faq">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-q">
            <span>{faq.q}</span>
            <span class="faq-mark" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none">
                <path d="M8 3.5v9M3.5 8h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </span>
          </summary>
          <div class="faq-a">
            <p>{faq.a}</p>
            {faq.link && (
              <p>
                <a
                  href={faq.link.href}
                  class="link"
                  {...(faq.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {faq.link.label}
                  {faq.link.external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section>
    <div class="doc-card support-close">
      <h2 id="contact" class="support-close-title">Still need help?</h2>
      <p>Email us and we'll get back to you within 48 hours.</p>
      <p style="margin-top:1.5rem">
        <a href={`mailto:${SUPPORT_EMAIL}`} class="btn btn-primary">
          {SUPPORT_EMAIL}
          <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </p>
    </div>
  </section>

  <nav class="doc-foot-links" aria-label="Related pages">
    <a href="/privacy" class="link">Privacy Policy</a>
    <a href="/terms" class="link">Terms of Service</a>
    <a href="/delete-account" class="link">Delete your account</a>
  </nav>
</DocLayout>

<style is:global>
  .support-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .faq {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    /* ≥44px tap target. */
    padding-block: 1.15rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    transition: color 0.18s ease;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:hover {
    color: var(--accent);
  }

  .faq-mark {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--muted);
    transition:
      transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .faq-mark svg {
    width: 11px;
    height: 11px;
  }

  .faq-item[open] .faq-mark {
    transform: rotate(135deg);
    color: var(--accent);
    border-color: var(--accent-soft);
  }

  .faq-a {
    padding-bottom: 1.25rem;
    padding-right: 2.5rem;
  }

  .faq-a p {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
  }

  .faq-a p:last-child {
    margin-bottom: 0;
  }

  /*
    Smooth open/close for <details>. `interpolate-size` is what lets height animate
    to `auto`, and `allow-discrete` keeps content-visibility from cutting the
    transition short. Browsers without support simply snap open — the correct
    degradation, since the content is identical either way.
  */
  @supports (interpolate-size: allow-keywords) {
    :root {
      interpolate-size: allow-keywords;
    }

    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        content-visibility 0.3s allow-discrete,
        opacity 0.25s ease;
    }

    .faq-item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  .support-close {
    text-align: center;
  }

  .support-close-title {
    margin-bottom: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
