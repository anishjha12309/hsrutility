---
import DocLayout from '../layouts/DocLayout.astro';
import Email from '../components/Email.astro';
import '../styles/doc-steps.css';
import {
  SUPPORT_EMAIL,
  SUPPORT_PHONE,
  LEGAL_NAME,
  ADDRESS_LINES,
  APPS,
  DAILYPASSBOOK,
  appNames,
  appNamesOr,
  wallpaperApps,
} from '../lib/site';
import { organizationSchema, websiteSchema, breadcrumbSchema, webPageSchema } from '../lib/schema';

/**
 * PORTED from the previous build. The structure is load-bearing for Play Store
 * compliance and is preserved exactly: in-app instant deletion leads, email is the
 * fallback, and the deleted/retained split is stated with its real retention periods.
 * Nothing here was softened or re-promised.
 *
 * Daily Passbook added 17 Nov 2026. The steps and lists below were written for the
 * wallpaper apps and are now labelled as theirs; Daily Passbook's own route and lists
 * follow each one, taken from its how-to-delete-account and privacy pages.
 */
const wallpaperNames = appNames(wallpaperApps());

const description =
  `How to permanently delete your ${appNamesOr()} account and data — instantly in the app, or by email as a fallback.`;

const structuredData = [
  organizationSchema,
  websiteSchema,
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Delete My Account' }]),
  webPageSchema({
    path: '/delete-account',
    name: `Delete Your Account & Data — ${appNames()} | HSR Utility`,
    description,
  }),
];

const inAppSteps = [
  'Open the app and go to the <strong>Settings</strong> tab.',
  'Tap <strong>Delete account</strong> at the bottom of the screen.',
  'Confirm. Your account and data are deleted <strong>immediately</strong>, your subscription and its UPI mandate are cancelled, and you are signed out. If we cannot reach the payment provider to cancel the mandate, the deletion is refused outright rather than half-applied — nothing is deleted and you can try again.',
];

const dailypassbookInAppSteps = [
  `Open ${DAILYPASSBOOK.name}, go to <strong>Settings</strong> and open the <strong>“Need Help?”</strong> section.`,
  'Tap <strong>Delete Account</strong> and confirm. Your plan is cancelled first, then your account is erased straight away. It cannot be undone.',
];

const emailSteps = [
  `Send an email to <!--email_off--><a href="mailto:${SUPPORT_EMAIL}">${SUPPORT_EMAIL}</a><!--/email_off--> with the subject line naming the app you use: <span class="mono-inline">Delete my account — ${appNamesOr()}</span>`,
  `Include the <strong>Google account email</strong> you used to sign in, so we can locate and verify your data. For ${DAILYPASSBOOK.name}, send the email from that Google account’s own address — we only act on a request sent from it.`,
  `We process it within <strong>7 business days</strong> (${DAILYPASSBOOK.name}: within 7 days) and email you a confirmation.`,
];

/**
 * Verified line by line against the DELETE /me handler in both app backends.
 *
 * Two things that used to be on this list were never true: "saved favourites"
 * (no app has ever had a favourites feature) and the Google "profile photo"
 * (sign-in only ever returns name, email and account id). Do not put them back.
 */
const deleted = [
  'Your account — the Google account linked at sign-in (name and email) and your display name',
  'Your referral code, your referral records, and any premium reward days',
  'Your subscription record, and the UPI AutoPay mandate itself, which is cancelled',
  'Any content you submitted that has not yet been published',
  'The analytics and advertising identifiers linked to your account on that device',
  'All locally cached app data, upon uninstalling the app',
];

/** From Daily Passbook's how-to-delete-account page. */
const dailypassbookDeleted = [
  'Your account and profile: name, email and Google account ID',
  'Your device records and sign-in sessions',
  'Every masked bank-message copy you shared',
  'Your subscription records (status, ids, debit count and amounts), erased with the account',
];

const retained = [
  {
    label: 'Published content you submitted',
    period: 'Stays in the app',
    note: 'Anything already reviewed and published remains in the library as anonymous content, with no link back to you. Email us if you want a published submission taken down.',
  },
  {
    // Deliberately survives deletion — see the trial tombstone in the privacy policy.
    label: 'One-off trial marker',
    period: 'Indefinite',
    note: 'A one-way hash of your Google account ID, so the one-trial-per-person limit cannot be reset by deleting and re-registering. No name, no email, nothing reversible.',
  },
  {
    label: 'Anonymised, aggregated analytics',
    period: '14 months',
    note: 'Already anonymous — cannot be linked back to you after deletion.',
  },
  {
    label: 'Anonymised crash logs',
    period: '90 days',
    note: 'For error tracking only; contains no personal identifiers after account deletion.',
  },
];
---

<DocLayout
  title={`Delete Your Account & Data — ${appNames()}`}
  heading="Delete your account &amp; data"
  eyebrow="Account & data"
  description={description}
  intro="You can permanently delete your account and its data at any time — instantly from inside the app, or by email if you no longer have it installed. This action is irreversible."
  structuredData={structuredData}
>
  <section>
    <p class="applies">
      <span class="applies-label">Applies to</span>
      {APPS.map((app) => <span class="applies-chip">{app.name}</span>)}
    </p>
  </section>

  {/* ── Primary path: in-app ─────────────────────────────────────────────── */}
  <section>
    <p class="method-flag">Fastest</p>
    <h2 id="in-app">Delete it in the app</h2>
    <p>Takes effect immediately — no waiting, no email needed.</p>
    <p><strong>{wallpaperNames}:</strong></p>
    <ol class="steps">
      {inAppSteps.map((step) => (
        <li>
          <span class="step-num accent" aria-hidden="true"></span>
          <span set:html={step} />
        </li>
      ))}
    </ol>
    <p style="margin-top:1.5rem"><strong>{DAILYPASSBOOK.name}</strong> ({DAILYPASSBOOK.deletePath}):</p>
    <ol class="steps">
      {dailypassbookInAppSteps.map((step) => (
        <li>
          <span class="step-num accent" aria-hidden="true"></span>
          <span set:html={step} />
        </li>
      ))}
    </ol>
  </section>

  {/* ── Fallback: email ──────────────────────────────────────────────────── */}
  <section>
    <h2 id="by-email">Prefer email? (or already uninstalled)</h2>
    <p>If you can't open the app, email us and we'll handle it for you.</p>

    <ol class="steps">
      {emailSteps.map((step) => (
        <li>
          <span class="step-num" aria-hidden="true"></span>
          <span set:html={step} />
        </li>
      ))}
    </ol>

    <p style="margin-top:1.75rem">
      <Email label="Email to delete" subject="Delete my account" class="btn btn-primary" arrow />
    </p>

    {/* Play review asked for a reachable number wherever we invite contact. Plain
        text, not a `tel:` link — see SUPPORT_PHONE in lib/site.ts. */}
    <dl class="doc-meta" style="margin-top:1.75rem">
      <div>
        <dt>Company</dt>
        <dd>{LEGAL_NAME}</dd>
      </div>
      <div>
        <dt>Phone</dt>
        <dd>{SUPPORT_PHONE}</dd>
      </div>
      <div>
        <dt>Address</dt>
        <dd>
          {ADDRESS_LINES.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </dd>
      </div>
    </dl>
  </section>

  {/* ── What goes, what stays ────────────────────────────────────────────── */}
  <section>
    <h2 id="what-happens">What gets deleted</h2>
    <p><strong>{wallpaperNames}:</strong></p>
    <ul>
      {deleted.map((item) => <li>{item}</li>)}
    </ul>
    <p><strong>{DAILYPASSBOOK.name}:</strong></p>
    <ul>
      {dailypassbookDeleted.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      {DAILYPASSBOOK.name}’s bank messages and history on your phone are not touched; remove the app to
      clear them.
    </p>
  </section>

  <section>
    <h2 id="retained">What we must retain</h2>
    <p><strong>{wallpaperNames}:</strong></p>
    <div class="doc-grid">
      {retained.map((item) => (
        <div class="doc-card">
          <p class="doc-card-period">{item.period}</p>
          <p class="doc-card-title">{item.label}</p>
          <p>{item.note}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:1rem">
      <strong>{DAILYPASSBOOK.name}:</strong> a one-way code of your sign-in identity is kept after
      deletion if you had used the free trial, so the trial is not given twice; it cannot be turned
      back into your identity. Our server deletes the analytics ids it kept; the analytics companies
      keep what they already received under their own retention rules.
    </p>
  </section>

  <section>
    <h2 id="premium">If you are a premium subscriber</h2>
    <p>
      Deleting is <strong>not</strong> cancelling. It ends premium access immediately: time left on the
      period you paid for is lost, with no refund, along with any referral reward days. Signing up
      again restores none of it and grants no new free trial.
    </p>
    <p>
      To stop future charges while keeping premium to the end of the period, cancel instead — Settings
      → your plan → Cancel — and delete later if you still want to.
    </p>
    <p>
      In {DAILYPASSBOOK.name}, deleting your account cancels your plan first, so there are no more debits.
      Premium ends at once, and the rest of the paid period is lost. To keep it to the end of the
      period, cancel instead — {DAILYPASSBOOK.cancelPath}.
    </p>
  </section>

  <section>
    <h2 id="per-app">What data our apps store</h2>
    <p>
      {wallpaperApps().length === 1 ? (
        <>{DAILYPASSBOOK.name} is a money app and stores different data from {wallpaperNames}.</>
      ) : (
        <>
          {wallpaperNames} collect the same categories of personal data, and differ mainly in the
          content they offer. {DAILYPASSBOOK.name} is a money app and stores different data.
        </>
      )}
    </p>
    {APPS.map((app) => (
      <div class="doc-card">
        <p class="doc-card-title">{app.name}</p>
        {app.legal ? (
          <p>
            Google account info from sign-in (name and email), your display name, content you
            submitted for review, in-app preferences, subscription and referral status, and
            analytics &amp; advertising identifiers.
          </p>
        ) : (
          <p>
            Google account info from sign-in (name, email and Google account ID), device details
            (maker and model, Android version, app version, language and a hashed install id),
            masked copies of the bank messages it recognised (shared from sign-in), subscription
            records, and analytics &amp; advertising identifiers. Your bank messages and payment
            history stay on your phone.
          </p>
        )}
      </div>
    ))}
  </section>

  <nav class="doc-foot-links" aria-label="Related pages">
    <a href="/support" class="link">Support &amp; FAQ</a>
    <a href="/privacy-policy" class="link">Privacy Policy</a>
    <a href="/terms" class="link">Terms of Service</a>
  </nav>
</DocLayout>
