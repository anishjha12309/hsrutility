---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  organizationSchema,
  websiteSchema,
  breadcrumbSchema,
  webPageSchema,
} from '../lib/schema';

const deleted = [
  'Your account — the Google account linked at sign-in (name, email, profile photo)',
  'Saved favourites, referral records and rewards',
  'Any content you submitted for review',
  'Your subscription record (premium status and dates)',
  'Analytics and advertising identifiers linked to your account',
  'All locally cached app data, upon uninstalling the app',
];

const retained = [
  {
    label: 'Anonymised, aggregated analytics',
    period: '14 months',
    note: 'Already anonymous — cannot be linked back to you after deletion.',
  },
  {
    label: 'Anonymised crash logs',
    period: '90 days',
    note: 'For error tracking only; contains no personal identifiers after account deletion.',
  },
];

const description =
  'How to permanently delete your Pakiza or Arul account and data — instantly in the app (Settings → Delete account), or by email as a fallback.';

const structuredData = [
  organizationSchema,
  websiteSchema,
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Delete My Account' }]),
  webPageSchema({
    path: Astro.url.pathname,
    name: 'Delete Your Account & Data — Pakiza & Arul | HSR Utility',
    description,
  }),
];
---

<Layout
  title="Delete Your Account & Data — Pakiza & Arul"
  description={description}
  structuredData={structuredData}
>
  <Navbar />

  <main class="pt-36 pb-24 px-6">
    <div class="max-w-3xl mx-auto">

      <!-- Header -->
      <div class="mb-14 reveal">
        <p class="section-label mb-4">Account &amp; Data</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-white leading-tight mb-4">
          Request deletion of your<br />account &amp; data
        </h1>
        <p class="text-slate-400 text-lg max-w-xl">
          You can permanently delete your account and all associated data at any time — instantly from inside the app, or by email if you no longer have it installed. This action is irreversible.
        </p>
      </div>

      <!-- Applies to -->
      <div class="glass-card rounded-2xl p-6 mb-10 reveal">
        <p class="text-muted text-xs font-semibold tracking-widest uppercase mb-3">Applies to</p>
        <div class="flex flex-wrap gap-2">
          {['Pakiza', 'Arul'].map(app => (
            <span class="text-slate-300 text-sm px-4 py-1.5 rounded-full border border-white/10 bg-white/[0.03]">
              {app}
            </span>
          ))}
        </div>
      </div>

      <!-- Primary: in-app -->
      <div class="glass-card rounded-2xl p-8 md:p-10 mb-6 reveal">
        <div class="flex items-center gap-3 mb-2">
          <span class="inline-block text-[10px] font-semibold tracking-[0.18em] uppercase text-gold-500 bg-gold-500/10 px-3 py-1 rounded-full">Fastest</span>
          <h2 class="font-serif text-2xl font-bold text-white">Delete it in the app</h2>
        </div>
        <p class="text-slate-400 text-sm mb-8">Takes effect immediately — no waiting, no email needed.</p>
        <div class="space-y-8">

          <!-- Step 1 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold-500/15 border border-gold-500/30 flex items-center justify-center text-gold-400 font-bold text-sm">1</div>
            <div class="pt-1">
              <p class="text-slate-300 leading-relaxed">
                Open the app and go to the <strong class="text-white">Settings</strong> tab.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold-500/15 border border-gold-500/30 flex items-center justify-center text-gold-400 font-bold text-sm">2</div>
            <div class="pt-1">
              <p class="text-slate-300 leading-relaxed">
                Tap <strong class="text-white">Delete account</strong> at the bottom of the screen.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold-500/15 border border-gold-500/30 flex items-center justify-center text-gold-400 font-bold text-sm">3</div>
            <div class="pt-1">
              <p class="text-slate-300 leading-relaxed">
                Confirm on the prompt. Your account and all associated data are deleted <strong class="text-white">right away</strong>, any active premium subscription is cancelled, and you are signed out.
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- Fallback: email -->
      <div class="glass-card rounded-2xl p-8 md:p-10 mb-10 reveal">
        <h2 class="font-serif text-2xl font-bold text-white mb-2">Prefer email? (or already uninstalled)</h2>
        <p class="text-slate-400 text-sm mb-8">If you can't open the app, email us and we'll handle it for you.</p>
        <div class="space-y-8">

          <!-- Step 1 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-slate-300 font-bold text-sm">1</div>
            <div class="pt-1">
              <p class="text-slate-300 leading-relaxed">
                Send an email to{' '}
                <a href="mailto:support@hsrutility.com" class="text-gold-400 hover:text-gold-300 transition-colors font-medium">
                  support@hsrutility.com
                </a>{' '}
                with the subject line (name the app you use):
              </p>
              <div class="mt-3 glass-card rounded-xl px-5 py-3 font-mono text-sm text-slate-200 select-all">
                Delete my account — Pakiza (or Arul)
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-slate-300 font-bold text-sm">2</div>
            <div class="pt-1">
              <p class="text-slate-300 leading-relaxed">
                Include the <strong class="text-white">Google account email</strong> you used to sign in, so we can locate and verify your data.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-slate-300 font-bold text-sm">3</div>
            <div class="pt-1">
              <p class="text-slate-300 leading-relaxed">
                We will process your request within <strong class="text-white">7 business days</strong> and send a confirmation email once your account and data have been permanently deleted.
              </p>
            </div>
          </div>

        </div>

        <div class="mt-8 pt-8 border-t border-white/5">
          <a
            href="mailto:support@hsrutility.com?subject=Delete%20my%20account"
            class="btn-gold"
          >
            Email to Delete
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- What gets deleted & retained -->
      <div class="grid md:grid-cols-2 gap-5 mb-10">

        <!-- Deleted -->
        <div class="glass-card rounded-2xl p-7 reveal">
          <p class="text-muted text-[10px] font-semibold tracking-[0.18em] uppercase mb-5">What Gets Deleted</p>
          <ul class="space-y-3">
            {deleted.map(item => (
              <li class="flex gap-3 text-sm text-slate-300">
                <span class="text-green-400 flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Retained -->
        <div class="glass-card rounded-2xl p-7 reveal reveal-d1">
          <p class="text-muted text-[10px] font-semibold tracking-[0.18em] uppercase mb-5">What We Must Retain</p>
          <div class="space-y-5">
            {retained.map(item => (
              <div>
                <div class="flex items-center justify-between gap-3 mb-1">
                  <p class="text-white font-medium text-sm">{item.label}</p>
                  <span class="text-[10px] font-semibold bg-white/5 border border-white/10 rounded-full px-2.5 py-1 text-slate-400 flex-shrink-0">{item.period}</span>
                </div>
                <p class="text-muted text-xs leading-relaxed">{item.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Per-app data -->
      <div class="glass-card rounded-2xl p-7 mb-10 reveal">
        <h2 class="font-serif text-xl font-bold text-white mb-2">What data our apps store</h2>
        <p class="text-slate-400 text-sm mb-6">Both apps collect the same categories of personal data — they differ only in the content they offer.</p>
        {['Pakiza', 'Arul'].map(app => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-5 border-t border-white/5">
            <div>
              <p class="text-white font-semibold mb-1">{app}</p>
              <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
                Google account info (sign-in), saved favourites and submitted content, in-app preferences, subscription status, and analytics &amp; advertising identifiers.
              </p>
            </div>
            <a
              href="mailto:support@hsrutility.com?subject=Delete%20my%20account"
              class="flex-shrink-0 border border-white/20 text-white text-xs font-semibold tracking-wider uppercase px-5 py-2.5 rounded-full hover:border-white/40 hover:bg-white/5 transition-all duration-200"
            >
              Email to Delete
            </a>
          </div>
        ))}
      </div>

      <!-- Back links -->
      <div class="flex flex-wrap gap-4 text-sm reveal">
        <a href="/support" class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Support
        </a>
        <a href="/privacy" class="text-slate-400 hover:text-white transition-colors">
          Privacy Policy
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
