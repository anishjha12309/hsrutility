---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SplitText from '../components/SplitText.astro';
import AppIcon from '../components/AppIcon.astro';
import { shotImage } from '../lib/media';
import { APPS, FREEMIUM_LINE, FREEMIUM_SHORT } from '../lib/site';
import {
  organizationSchema,
  websiteSchema,
  pakizaAppSchema,
  arulAppSchema,
  webPageSchema,
} from '../lib/schema';

const description =
  'HSR Utility is an indie Android studio making wallpaper and ringtone apps for specific cultural audiences — still and live wallpapers, curated ringtones, free to browse.';

const structuredData = [
  organizationSchema,
  websiteSchema,
  pakizaAppSchema,
  arulAppSchema,
  webPageSchema({
    path: '/',
    name: 'HSR Utility — indie Android studio behind Pakiza and Arul',
    description,
  }),
];

/** What the studio actually ships, as hero chips. */
const heroChips = ['Wallpapers', 'Live wallpapers', 'Ringtones', 'Offline reminders'];
---

<Layout title="Indie Android studio" description={description} structuredData={structuredData}>
  {/* ── Hero — copy left, capped screenshot fan right. The fan shows one shot
      per app up to three; past that a "+N more" chip absorbs the rest, so a
      fifth app never breaks this layout. ─────────────────────────────────── */}
  <section class="hero" data-hero aria-labelledby="hero-heading">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <ul class="hero-chips reveal-fade" aria-label="What we make">
          {heroChips.map((chip) => <li class="chip">{chip}</li>)}
        </ul>

        <h1 id="hero-heading" class="display-1">
          <SplitText text="Screens worth looking at." accent={['looking']} />
        </h1>

        <div class="hero-tail" data-hero-tail style="--ti:0">
          <p class="lede hero-lede">
            Wallpaper and ringtone apps for people whose faith and culture deserve better
            than whatever shipped on the phone. Curated by hand, free to browse.
          </p>

          <div class="hero-actions">
            <a href="#apps" class="btn btn-primary">
              See the apps
              <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>

            <a href="/support" class="btn btn-ghost">
              Get help
              <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="hero-fan" data-hero-tail style="--ti:1">
        <div class="fan-stage" data-count={Math.min(APPS.length, 3)} data-parallax>
          {APPS.slice(0, 3).map((app, i) => {
            const [shot] = app.shots;
            return (
              <a href={`/${app.slug}`} class="fan-card" aria-label={`${app.name} — see the app`}>
                <Picture
                  src={shotImage(shot.file)}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  quality={55}
                  width={420}
                  widths={[260, 340, 420]}
                  sizes="(min-width: 900px) 220px, 40vw"
                  loading="eager"
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                  class="fan-img"
                />
              </a>
            );
          })}
          {APPS.length > 3 && (
            <a href="#apps" class="chip fan-more">+{APPS.length - 3} more</a>
          )}
        </div>
      </div>
    </div>

    {/* Marks where the hero ends; the navbar condenses once this leaves the viewport. */}
    <div data-nav-sentinel aria-hidden="true"></div>
  </section>

  {/* ── One mega-panel per app: ink, then blue. Rendered from APPS. ────────── */}
  <div id="apps" class="shell apps">
    {APPS.map((app, i) => {
      {/* The hero fan already shows shots[0]; the panel takes the next graphic
          so the page never repeats an asset above and below the fold. */}
      const panelShot = app.shots[1] ?? app.shots[0];
      return (
        <section
          class:list={['panel', i % 2 === 1 ? 'panel-blue' : 'panel-ink', 'app-panel', 'reveal']}
          aria-labelledby={`${app.slug}-heading`}
        >
          <div class="app-copy">
            <p class="eyebrow app-status">{app.statusLabel}</p>

            <div class="app-title">
              <AppIcon app={app} size={64} class="app-title-icon" />
              <h2 id={`${app.slug}-heading`} class="display-2">{app.name}</h2>
            </div>

            <p class="app-tagline">{app.tagline}.</p>
            <p class="app-desc">{app.description}</p>

            <p class="eyebrow app-cap-label">Inside the app</p>
            <ul class="check-list app-caps">
              {app.features.slice(0, 5).map((feature) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 7.5 5.5 10.5 11.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  {feature.title}
                </li>
              ))}
            </ul>

            <div class="app-actions">
              {app.playUrl ? (
                <a href={app.playUrl} class="btn btn-primary" rel="noopener noreferrer" target="_blank">
                  Get it on Google Play
                  <span class="sr-only">(opens in a new tab)</span>
                  <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </a>
              ) : (
                <span class="chip app-soon">Coming soon to Google Play</span>
              )}

              <a href={`/${app.slug}`} class="btn btn-ghost">
                More about {app.name}
                <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            </div>
          </div>

          <div class="app-shot" data-parallax>
            <Picture
              src={shotImage(panelShot.file)}
              alt={panelShot.alt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              quality={55}
              width={520}
              widths={[300, 420, 520]}
              sizes="(min-width: 900px) 380px, 78vw"
              loading="lazy"
              decoding="async"
              class="app-shot-img"
            />
          </div>
        </section>
      );
    })}
  </div>

  {/* ── Trust strip — short, factual, no card theatre. ─────────────────────── */}
  <div class="shell strip-section">
    <dl class="strip reveal">
      <div class="strip-item">
        <dt class="strip-title">{FREEMIUM_SHORT}</dt>
        <dd class="strip-body">{FREEMIUM_LINE}</dd>
      </div>
      <div class="strip-item">
        <dt class="strip-title">No analytics. No cookies.</dt>
        <dd class="strip-body">
          This site makes no third-party requests of any kind, and the reminders in the
          apps run fully offline.
        </dd>
      </div>
      <div class="strip-item">
        <dt class="strip-title">Made for someone specific.</dt>
        <dd class="strip-body">
          Every app is built for one audience, curated by hand, and judged on whether it
          serves them well. Nothing here is a reskin.
        </dd>
      </div>
    </dl>
  </div>
</Layout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding-block: clamp(7.5rem, 5.5rem + 8vh, 10.5rem) clamp(2.5rem, 5vh, 4rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
  }

  .hero-tail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hero-lede {
    max-width: 52ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Screenshot fan ─────────────────────────────────────────────────────
     data-hero-tail lives on the wrapper and data-parallax on the stage —
     both animate transform, and stacking them on one element would leave the
     CSS entrance keyframe (fill: both) fighting GSAP's inline transform. */
  .fan-stage {
    position: relative;
    height: clamp(19rem, 42vw, 27rem);
  }

  .fan-card {
    position: absolute;
    display: block;
    width: 47%;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.25s ease;
  }

  @media (hover: hover) {
    .fan-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-pop);
      z-index: 3;
    }
  }

  .fan-card :global(.fan-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 15;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* Two apps: a relaxed pair. */
  [data-count='2'] .fan-card:nth-child(1) { left: 2%; top: 0; }
  [data-count='2'] .fan-card:nth-child(2) { right: 2%; top: 12%; }

  /* Three or more: a tighter fan; the centre card leads. */
  [data-count='3'] .fan-card { width: 38%; }
  [data-count='3'] .fan-card:nth-child(1) { left: 0; top: 8%; }
  [data-count='3'] .fan-card:nth-child(2) { left: 31%; top: 0; z-index: 2; }
  [data-count='3'] .fan-card:nth-child(3) { right: 0; top: 14%; }

  .fan-more {
    position: absolute;
    right: 0;
    bottom: 0;
    text-decoration: none;
  }

  /* ── App mega-panels ────────────────────────────────────────────────────── */
  .apps {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding-block: clamp(1.5rem, 3vw, 3rem) 0;
  }

  .app-panel {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .app-panel {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      /* The shot column hangs to the panel's bottom edge. */
      padding-bottom: 0;
    }
  }

  .app-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    /* Restores the breathing room the grid gave up for the hanging shot. */
    padding-bottom: clamp(0.25rem, 2vw, 3.5rem);
  }

  .app-status {
    color: var(--muted);
  }

  .app-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .app-title h2 {
    margin: 0;
  }

  .app-tagline {
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.4375rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .app-desc {
    margin: 0;
    max-width: 52ch;
    color: var(--muted);
  }

  .app-cap-label {
    margin: 0.75rem 0 -0.25rem;
  }

  .app-caps {
    color: var(--text);
  }

  .app-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  /* "Coming soon" is a statement, not a control. */
  .app-soon {
    min-height: 3rem;
  }

  /* ── Panel screenshot — bottom-bleeds out of the panel like a product shot. */
  .app-shot {
    align-self: end;
    justify-self: center;
    width: min(78vw, 380px);
  }

  .app-shot :global(.app-shot-img) {
    width: 100%;
    height: auto;
    /* Top ~4:5 of the tall store graphic; the panel edge crops the rest. */
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
    object-position: top;
    border-radius: 1rem 1rem 0 0;
    border: 1px solid var(--line);
    border-bottom: 0;
    box-shadow: var(--shadow-card);
  }

  /* ── Trust strip ────────────────────────────────────────────────────────── */
  .strip-section {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) 0;
  }

  .strip {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .strip-title {
    margin: 0 0 0.4rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    font-size: 1.0625rem;
    color: var(--text);
  }

  .strip-body {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
