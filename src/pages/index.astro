---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  organizationSchema,
  websiteSchema,
  pakizaAppSchema,
  arulAppSchema,
  webPageSchema,
  ORG_DESCRIPTION,
} from '../lib/schema';

const description =
  'HSR Utility builds beautifully designed devotional wallpaper and ringtone apps for Android — Pakiza (Islamic) and Arul (South Indian devotional).';

const structuredData = [
  organizationSchema,
  websiteSchema,
  pakizaAppSchema,
  arulAppSchema,
  webPageSchema({
    path: Astro.url.pathname,
    name: 'HSR Utility – Devotional Wallpaper & Ringtone Apps for Android',
    description,
  }),
];

// Two apps, one studio. Availability is intentionally conservative — no app is
// claimed live until a real Play Store listing is linked here.
const apps = [
  {
    name: 'Pakiza',
    tagline: 'Islamic wallpapers & nasheeds',
    blurb:
      'A curated collection of HD and live Islamic wallpapers with ringtones and nasheeds — browse and preview free, with an optional premium plan to set and save.',
    tags: ['HD Wallpapers', 'Live Wallpapers', 'Ringtones', 'Nasheeds', 'Free to browse'],
    status: 'Coming soon',
  },
  {
    name: 'Arul',
    tagline: 'South Indian devotional wallpapers & ringtones',
    blurb:
      'HD and live devotional wallpapers and ringtones across Amman, Ayyappan, Murugan, Perumal, Sivan and Temples — browse and preview free, with an optional premium plan to set and save.',
    tags: ['HD Wallpapers', 'Live Wallpapers', 'Ringtones', 'Six Deities', 'Free to browse'],
    status: 'Coming soon',
  },
];
---

<Layout
  title="HSR Utility – Devotional Wallpaper & Ringtone Apps"
  description={description}
  structuredData={structuredData}
>
  <Navbar />

  <main>
  <!-- ── HERO ── -->
  <section class="relative min-h-screen flex flex-col items-center justify-center px-6 pt-28 pb-20 overflow-hidden">

    <!-- Background glows -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-[60%] w-[700px] h-[700px] rounded-full bg-gold-500/[0.04] blur-[140px]"></div>
      <div class="absolute top-1/3 right-[15%] w-[300px] h-[300px] rounded-full bg-indigo-700/[0.05] blur-[100px]"></div>
      <div class="absolute bottom-1/4 left-[10%] w-[250px] h-[250px] rounded-full bg-gold-600/[0.03] blur-[80px]"></div>
    </div>

    <div class="relative z-10 text-center max-w-3xl mx-auto">

      <!-- Badge — enters first -->
      <div class="animate-fade-up delay-1 inline-flex items-center gap-2.5 glass-card rounded-full px-4 py-2 mb-10 text-sm text-slate-300" style="border: 2px solid rgba(201,168,76,0.35);">
        <span class="w-2 h-2 rounded-full bg-gold-500 animate-pulse flex-shrink-0"></span>
        Building for Android
      </div>

      <!-- Headline -->
      <h1 class="animate-fade-up delay-2 font-serif text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.08] mb-6 tracking-tight">
        Devotion,<br />
        <em class="text-gold-400 not-italic">beautifully designed.</em>
      </h1>

      <!-- Subtext -->
      <p class="animate-fade-up delay-3 text-slate-400 text-lg md:text-xl leading-relaxed mb-10 max-w-xl mx-auto">
        HSR Utility crafts thoughtfully designed wallpaper and ringtone apps for Android — devotional collections made for the communities they serve.
      </p>

      <!-- CTAs -->
      <div class="animate-fade-up delay-4 flex flex-wrap items-center justify-center gap-4">
        <a href="#apps" class="btn-gold">
          Explore our apps
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/support" class="btn-ghost">Get in Touch</a>
      </div>
    </div>

    <!-- Stats bar — enters last -->
    <div class="animate-fade-up delay-5 relative z-10 mt-20 w-full max-w-sm mx-auto">
      <div class="glass-card rounded-2xl grid grid-cols-3 divide-x divide-white/5">
        <div class="py-6 text-center">
          <p class="font-serif text-2xl font-bold text-white">2</p>
          <p class="text-muted text-[10px] uppercase tracking-widest mt-1">Apps</p>
        </div>
        <div class="py-6 text-center">
          <p class="font-serif text-2xl font-bold text-white">Android</p>
          <p class="text-muted text-[10px] uppercase tracking-widest mt-1">Platform</p>
        </div>
        <div class="py-6 text-center">
          <p class="font-serif text-2xl font-bold text-white">2026</p>
          <p class="text-muted text-[10px] uppercase tracking-widest mt-1">Founded</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── OUR APPS ── -->
  <section id="apps" class="py-24 px-6 scroll-mt-20">
    <div class="max-w-4xl mx-auto">

      <!-- Section header -->
      <div class="reveal mb-14">
        <p class="section-label mb-4">Our Apps</p>
        <h2 class="section-heading mb-4">Two apps, one standard of care.</h2>
        <p class="section-subtext max-w-lg">
          Each app is crafted for its own community — the same attention to design, performance, and privacy across both.
        </p>
      </div>

      <div class="space-y-6">
        {apps.map((app, i) => (
          <div class={`reveal ${i === 1 ? 'reveal-d1' : ''} glass-card card-lift rounded-3xl p-8 md:p-10`}>
            <div class="flex flex-col sm:flex-row gap-8 items-start">

              <!-- App icon -->
              <div class="flex-shrink-0">
                <div class="w-20 h-20 rounded-[22px] overflow-hidden shadow-2xl shadow-black/40">
                  {app.name === 'Pakiza' ? (
                    <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" role="img" aria-label="Pakiza app icon">
                      <rect width="80" height="80" fill="#1a1b35"/>
                      <circle cx="43" cy="38" r="21" fill="#c9a84c" opacity="0.95"/>
                      <circle cx="52" cy="29" r="16" fill="#1a1b35"/>
                      <circle cx="58" cy="47" r="3.5" fill="#c9a84c"/>
                      <circle cx="65" cy="36" r="2.5" fill="#c9a84c" opacity="0.75"/>
                      <circle cx="61" cy="54" r="1.8" fill="#c9a84c" opacity="0.5"/>
                    </svg>
                  ) : (
                    <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" role="img" aria-label="Arul app icon">
                      <rect width="80" height="80" fill="#1a1b35"/>
                      <!-- Stylised lamp flame / lotus in temple gold -->
                      <path d="M40 18c6 8 11 13 11 21a11 11 0 01-22 0c0-8 5-13 11-21z" fill="#c9a84c" opacity="0.95"/>
                      <path d="M40 30c2.6 3.6 4.6 5.8 4.6 9.4a4.6 4.6 0 01-9.2 0c0-3.6 2-5.8 4.6-9.4z" fill="#1a1b35"/>
                      <path d="M26 58h28M30 63h20" stroke="#c9a84c" stroke-width="3" stroke-linecap="round" opacity="0.8"/>
                    </svg>
                  )}
                </div>
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-3">
                  <span class="w-2 h-2 rounded-full bg-amber-400 flex-shrink-0"></span>
                  <span class="text-amber-400 text-xs font-medium">{app.status}</span>
                </div>
                <h3 class="font-serif text-2xl md:text-3xl font-bold text-white mb-1">
                  {app.name}
                </h3>
                <p class="text-gold-400 text-sm font-medium mb-3">{app.tagline}</p>
                <p class="text-slate-400 leading-relaxed mb-6">
                  {app.blurb}
                </p>
                <div class="flex flex-wrap gap-2">
                  {app.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Footer row -->
            <div class="mt-8 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <p class="text-muted text-sm">Coming soon to Google Play</p>
              <span class="inline-flex items-center gap-2 text-muted text-sm border border-white/10 rounded-full px-4 py-2 select-none">
                <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M3.18 23.76c.33.18.7.24 1.06.18L17 16.56l-2.82-2.82L3.18 23.76zM.6 1.88C.22 2.22 0 2.78 0 3.5v17c0 .72.22 1.28.6 1.62l.08.08L9.76 12v-.22L.68 1.8.6 1.88zm20.08 8-2.96-1.7L14.88 12l2.84 2.84 2.96-1.7c.84-.48.84-1.28 0-1.76zM4.24.06l12.48 7.2-2.84 2.82L4.24.06z"/>
                </svg>
                Coming Soon
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FEATURES ── -->
  <section class="py-24 px-6">
    <div class="max-w-5xl mx-auto">

      <!-- Section header -->
      <div class="reveal mb-14">
        <p class="section-label mb-4">Why our apps</p>
        <h2 class="section-heading mb-4">Built with purpose.</h2>
        <p class="section-subtext max-w-md">
          Every design decision serves the people who use it — beautiful, intentional, and honest about your data.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

        <!-- HD & Live -->
        <div class="reveal glass-card card-lift rounded-2xl p-8">
          <div class="w-11 h-11 rounded-xl bg-gold-500/10 flex items-center justify-center mb-6 transition-colors duration-300 group-hover:bg-gold-500/20">
            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white text-lg mb-2">HD &amp; live</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Static and live video wallpapers, carefully optimised to stay crisp and smooth on every screen size.
          </p>
        </div>

        <!-- Free to browse -->
        <div class="reveal reveal-d1 glass-card card-lift rounded-2xl p-8">
          <div class="w-11 h-11 rounded-xl bg-gold-500/10 flex items-center justify-center mb-6">
            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white text-lg mb-2">Free to browse</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Browse and preview every wallpaper and ringtone for free. An optional premium plan unlocks setting and saving.
          </p>
        </div>

        <!-- Private by design -->
        <div class="reveal reveal-d2 glass-card card-lift rounded-2xl p-8">
          <div class="w-11 h-11 rounded-xl bg-gold-500/10 flex items-center justify-center mb-6">
            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white text-lg mb-2">Private by design</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            No content is sold or shared for advertising by us. Sign in with Google, and delete your account and data whenever you want.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CONTACT CTA ── -->
  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto reveal">
      <div class="glass-card rounded-3xl p-10 md:p-16 text-center relative overflow-hidden">
        <!-- Subtle glow behind -->
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <div class="w-64 h-64 rounded-full bg-gold-500/[0.06] blur-[80px]"></div>
        </div>
        <div class="relative z-10">
          <p class="section-label mb-5">Get in Touch</p>
          <h2 class="font-serif text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">
            We'd love to hear from you.
          </h2>
          <p class="text-slate-400 text-lg mb-8 max-w-md mx-auto">
            Questions, feedback, or feature requests for Pakiza or Arul — we reply within 48 hours.
          </p>
          <a
            href="mailto:support@hsrutility.com"
            class="font-serif text-2xl md:text-3xl text-gold-400 hover:text-gold-300 transition-colors block mb-8 break-all"
          >
            support@hsrutility.com
          </a>
          <a href="/support" class="btn-ghost">
            Visit Support Page
          </a>
        </div>
      </div>
    </div>
  </section>
  </main>

  <Footer />
</Layout>
