---
import Layout from '../layouts/Layout.astro';
import SplitText from '../components/SplitText.astro';
import AppIcon from '../components/AppIcon.astro';
import { APPS, FREEMIUM_LINE, FREEMIUM_SHORT } from '../lib/site';
import {
  organizationSchema,
  websiteSchema,
  pakizaAppSchema,
  arulAppSchema,
  webPageSchema,
} from '../lib/schema';

const description =
  'HSR Utility is an indie Android studio making wallpaper and ringtone apps for specific cultural audiences — still and live wallpapers, curated ringtones, free to browse.';

const structuredData = [
  organizationSchema,
  websiteSchema,
  pakizaAppSchema,
  arulAppSchema,
  webPageSchema({
    path: '/',
    name: 'HSR Utility — indie Android studio behind Pakiza and Arul',
    description,
  }),
];

/** What the studio actually ships, as hero chips. */
const heroChips = ['Wallpapers', 'Live wallpapers', 'Ringtones', 'Offline reminders'];

/**
 * NO APP ARTWORK ON THIS PAGE. Every screenshot and store graphic belongs to the
 * app's own sub-site and appears only there.
 *
 * This is the one page where both app names sit together, and it used to sit them
 * together as a designed pair: a hero fan that placed Pakiza's mosque graphic beside
 * Arul's deity graphic, then a full-width themed slab each. One serves an Islamic
 * audience and the other a Hindu one, and that composition invited a reading neither
 * app asks for. What replaces it is a plain card per app on one neutral surface —
 * the apps are the focus, the facts do the work, and no layout decision implies a
 * relationship between them. Do not reintroduce a shot, a shared strip or a
 * side-by-side comparison here.
 */
---

<Layout title="Indie Android studio" description={description} structuredData={structuredData}>
  {/* ── Hero — copy only. The screenshot fan that sat to its right showed one
      graphic per app side by side; see the note in the frontmatter for why it is
      gone rather than merely reordered. ──────────────────────────────────── */}
  <section class="hero" data-hero aria-labelledby="hero-heading">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <ul class="hero-chips reveal-fade" aria-label="What we make">
          {heroChips.map((chip) => <li class="chip">{chip}</li>)}
        </ul>

        <h1 id="hero-heading" class="display-1">
          <SplitText text="Screens worth looking at." accent={['looking']} />
        </h1>

        <div class="hero-tail" data-hero-tail style="--ti:0">
          <p class="lede hero-lede">
            Wallpaper and ringtone apps for people whose faith and culture deserve better
            than whatever shipped on the phone. Curated by hand, free to browse.
          </p>

          <div class="hero-actions">
            <a href="#apps" class="btn btn-primary">
              See the apps
              <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>

            <a href="/support" class="btn btn-ghost">
              Get help
              <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    {/* Marks where the hero ends; the navbar condenses once this leaves the viewport. */}
    <div data-nav-sentinel aria-hidden="true"></div>
  </section>

  {/* ── One card per app, on one neutral surface. Rendered from APPS. ─────── */}
  <section id="apps" class="shell apps-section" aria-labelledby="apps-heading">
    <header class="apps-head reveal">
      <p class="eyebrow">Our apps</p>
      <h2 id="apps-heading" class="display-2">Built for one audience each.</h2>
    </header>

    <div class="apps-grid">
      {APPS.map((app) => (
        <article class="app-card reveal" aria-labelledby={`${app.slug}-heading`}>
          <p class="eyebrow app-status">{app.statusLabel}</p>

          <div class="app-title">
            <AppIcon app={app} size={52} class="app-title-icon" />
            <h3 id={`${app.slug}-heading`} class="app-name">{app.name}</h3>
          </div>

          <p class="app-tagline">{app.tagline}.</p>
          <p class="app-desc">{app.description}</p>

          <ul class="check-list app-caps">
            {app.features.slice(0, 3).map((feature) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7.5 5.5 10.5 11.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                {feature.title}
              </li>
            ))}
          </ul>

          {/* Pushed to the card's foot so two cards of unequal copy still line up. */}
          <div class="app-actions">
            <a href={`/${app.slug}`} class="btn btn-primary">
              More about {app.name}
              <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>

            {app.playUrl && (
              <a href={app.playUrl} class="btn btn-ghost" rel="noopener noreferrer" target="_blank">
                Google Play
                <span class="sr-only">(opens in a new tab)</span>
                <svg class="btn-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* ── Trust strip — short, factual, no card theatre. ─────────────────────── */}
  <div class="shell strip-section">
    <dl class="strip reveal">
      <div class="strip-item">
        <dt class="strip-title">{FREEMIUM_SHORT}</dt>
        <dd class="strip-body">{FREEMIUM_LINE}</dd>
      </div>
      <div class="strip-item">
        <dt class="strip-title">No analytics. No cookies.</dt>
        <dd class="strip-body">
          This site makes no third-party requests of any kind, and the reminders in the
          apps run fully offline.
        </dd>
      </div>
      <div class="strip-item">
        <dt class="strip-title">Made for someone specific.</dt>
        <dd class="strip-body">
          Every app is built for one audience, curated by hand, and judged on whether it
          serves them well. Nothing here is a reskin.
        </dd>
      </div>
    </dl>
  </div>
</Layout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding-block: clamp(7.5rem, 5.5rem + 8vh, 10.5rem) clamp(2.5rem, 5vh, 4rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero h1 {
    max-width: 12ch;
    margin: 0;
  }

  .hero-tail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hero-lede {
    max-width: 52ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── App cards ──────────────────────────────────────────────────────────
     One neutral surface for every app, not the alternating ink/blue slabs that
     were here before. Two apps of different faiths on one page should read as a
     list of products; giving each its own themed full-width panel made them read
     as a matched pair, which is exactly the impression to avoid. */
  .apps-section {
    padding-block: clamp(2rem, 4vw, 4rem) 0;
  }

  /* 40ch, not 28: `ch` measures the display serif's narrow zero, so 28 broke a
     28-character heading across three ragged lines. */
  .apps-head {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 40ch;
    margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
  }

  .apps-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    /* auto-fit, so a third app wraps into the same rhythm with no edit here. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .app-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: var(--surface);
  }

  .app-status {
    color: var(--muted);
  }

  .app-title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .app-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .app-tagline {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .app-desc {
    margin: 0;
    max-width: 48ch;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .app-caps {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--text);
  }

  /* margin-top:auto — the actions sit on the card's floor, so cards holding
     different amounts of copy still line their buttons up across the row. */
  .app-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  /* ── Trust strip ────────────────────────────────────────────────────────── */
  .strip-section {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) 0;
  }

  .strip {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .strip-title {
    margin: 0 0 0.4rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    font-size: 1.0625rem;
    color: var(--text);
  }

  .strip-body {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
