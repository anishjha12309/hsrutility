---
import DocLayout from '../../layouts/DocLayout.astro';
import Email from '../../components/Email.astro';
import LegalContact from '../../components/LegalContact.astro';
import LegalFootLinks from '../../components/LegalFootLinks.astro';
import { ALERTPAISA, LEGAL_NAME, legalPath } from '../../lib/site';
import { organizationSchema, websiteSchema, breadcrumbSchema, webPageSchema } from '../../lib/schema';

/**
 * AlertPaisa's privacy policy. NOT the shared wallpaper template in src/pages/[app]/:
 * AlertPaisa is a money app and its data is different (masked bank messages, device
 * details, PhonePe mandate records, three analytics companies).
 *
 * Ported from `~/AlertPaisa/web/src/pages/privacy.tsx` (rewritten 17 Nov 2026; the
 * in-app policy and the Play data-safety answers match it). Keep the meaning and
 * every fact in step with that file. Changes made in the port: the contact is
 * support@ (via Email / LegalContact) instead of admin@, the opening names the
 * registered company and the package, links go through legalPath() with trailing
 * slashes, "Changes and contact" became two sections so the LegalContact block can
 * close the page, and the retention paragraph is laid out as cards (same facts).
 */

const app = ALERTPAISA;
const lastUpdated = 'November 2026';

const description = `Privacy policy for ${app.name}: what stays on your phone, what the app sends to our server, payments, analytics, masking, how long data is kept, and how to delete your account.`;

const structuredData = [
  organizationSchema,
  websiteSchema,
  breadcrumbSchema([{ name: app.name, path: `/${app.slug}` }, { name: 'Privacy Policy' }]),
  webPageSchema({
    path: legalPath(app, 'privacy-policy'),
    name: `Privacy Policy — ${app.name} | HSR Utility`,
    description,
  }),
];

/** What the app sends to our server. Every item is load-bearing. */
const sent = [
  {
    title: 'Sign-in',
    body: 'You sign in with Google. We keep your name, your Google email and your Google account ID.',
  },
  {
    title: 'Device',
    body: 'Phone maker and model, Android version, app version, app language and a random install id (stored only as a hash).',
  },
  {
    title: 'Masked bank messages, shared from sign-in',
    body: 'For each bank message the app recognised, the sender id, a masked copy of the text, what the app understood it to be and whether it was spoken. Also the bank, amount and balance the app read, whether the message came in live or was found by a scan of older messages, your phone’s state when the message came (battery and charging, sound mode and volume, screen on or off, power saver, battery optimisation), and how many milliseconds each step took.',
  },
  {
    title: 'Sharing status',
    body: 'That sharing is on, and when it started.',
  },
  {
    title: 'Subscription',
    body: 'If you start the ₹2 trial or subscribe, the server keeps your subscription status, the PhonePe mandate id, the order ids, the trial and renewal dates, how many monthly debits were taken and the amounts paid.',
  },
];

const payments = [
  'What our server sends PhonePe: an order id, a subscription (mandate) id, the amount, and the UPI app you picked (or that you chose a QR code). It sends no name, email or phone number.',
  'What PhonePe sends back: the order and mandate state, ids and amounts, and later each monthly debit and any cancel or pause.',
  'The app contains PhonePe’s payment SDK, used only when the UPI app route cannot be used. It opens PhonePe’s own payment page.',
  'No card number, bank account or UPI PIN passes through the app or our server. You enter your UPI credentials only in your UPI app.',
  'PhonePe handles payment data under its own privacy policy.',
  'You can cancel in the app. Your plan stays active to the end of the paid period.',
];

const analyticsCompanies = [
  'Google: Firebase and Google Analytics, and Google Ads through them.',
  'Meta (Facebook).',
  'PostHog, an analytics service.',
];

const analyticsData = [
  'App events: signing up, opening the paywall, starting checkout, starting the trial, and a purchase.',
  'For a purchase: its value (for example ₹199), the currency and the order id.',
  'Three ids: the Firebase app instance id, Meta’s install id, and your phone’s advertising ID. The advertising ID is never sent if you limited ad tracking on your phone.',
  'Device details: phone model, Android version, app version and app language (to Meta, with purchase events).',
  'PostHog also gets your AlertPaisa account id.',
];

const retention = [
  {
    period: 'While your account exists',
    label: 'Account & device data',
    note: 'Kept while your account exists.',
  },
  {
    period: 'While your account exists',
    label: 'Subscription records',
    note: 'Status, ids, debit count and amounts. Kept while your account exists and erased with it.',
  },
  {
    period: 'Until you delete your account',
    label: 'Shared bank-message copies',
    note: 'Deleting your account stops sharing and erases them.',
  },
  {
    period: 'After deletion',
    label: 'One-way trial code',
    note: 'A one-way code of your sign-in identity is kept after deletion if you had used the free trial, so the trial is not given twice. It cannot be turned back into your identity.',
  },
];
---

<DocLayout
  title={`Privacy Policy — ${app.name}`}
  heading="Privacy Policy"
  eyebrow={`${app.name} — legal`}
  description={description}
  lastUpdated={lastUpdated}
  structuredData={structuredData}
  scope={app}
>
  <section>
    <p>
      {app.name} speaks your bank debits and credits aloud. It is made by UtilityVerse and operated
      by <strong>{LEGAL_NAME}</strong>, trading as HSR Utility. This policy covers
      <strong>{app.name}</strong> (package <code>{app.packageId}</code>) and nothing else. Privacy
      contact: <Email />.
    </p>
  </section>

  <section>
    <h2 id="sign-in">1. Sign-in and a Plan</h2>
    <p>
      Google sign-in is required to use {app.name}. The app also needs an active plan: a running ₹2
      one-day trial or the ₹199 monthly plan. Without one, the app’s features do not work, but
      messages that arrive meanwhile are still read and kept on your phone. The
      <a href={legalPath(app, 'terms')}>terms</a> and the
      <a href={legalPath(app, 'refund-policy')}>refund policy</a> have the details.
    </p>
  </section>

  <section>
    <h2 id="on-device">2. What Stays on Your Phone</h2>
    <p>
      The app reads your bank SMS and notifications on the phone to speak them and to remind you
      before autopay, EMI and bill due dates. That reading, the parsing and your payment history stay
      on the phone. The app shows no ads.
    </p>
  </section>

  <section>
    <h2 id="collect">3. What the App Sends to Our Server</h2>
    {sent.map((item) => (
      <div class="doc-card">
        <p class="doc-card-title">{item.title}</p>
        <p>{item.body}</p>
      </div>
    ))}
  </section>

  <section>
    <h2 id="payments">4. Payments</h2>
    <p>
      Payments for the ₹2 trial and the ₹199 monthly plan are handled by PhonePe, our payment
      processor, through UPI Autopay.
    </p>
    <ul>{payments.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section>
    <h2 id="analytics">5. Ads and Analytics</h2>
    <p>
      The app tells three companies how people find and use {app.name}, so we can see which ads work:
    </p>
    <ul>{analyticsCompanies.map((item) => <li>{item}</li>)}</ul>
    <p>What they get:</p>
    <ul>{analyticsData.map((item) => <li>{item}</li>)}</ul>
    <p>
      They never get your SMS text, your bank amounts or balances, or the content of any message.
      Each company keeps what it gets under its own retention rules.
    </p>
    <p>
      This starts only after you agree at sign-in, and signing in is the agreement. There is no switch
      for it: deleting your account stops it, and our server then deletes the three ids it kept. You
      can also reset or delete your advertising ID in your phone’s Google settings.
    </p>
  </section>

  <section>
    <h2 id="masking">6. What Is Masked, and What Is Never Sent</h2>
    <p>
      The phone masks phone numbers, account and reference digits, UPI ids and emails in the text and
      the sender id before anything is sent, and the server checks again. Names are masked when the
      phone can spot them (your name, the payee, and names after words like “to” or “from”), so other
      names can still appear. Amounts, dates and times stay. OTP messages and personal messages are
      never sent.
    </p>
  </section>

  <section>
    <h2 id="use">7. Why</h2>
    <p>
      To run your account, to count who uses which app version, and, for the masked bank messages, to
      find messages the app read wrongly or did not speak, so detection can be improved. They are used
      only for that, are read by the developer only, and are never sold. There are no ads.
    </p>
  </section>

  <section>
    <h2 id="consent">8. The Notice, and Your Agreement</h2>
    <p>
      The notice at the bottom of the sign-in screen reads: “By continuing, you agree to share masked
      bank messages and usage analytics, and to our Privacy Policy.” Tapping Continue with Google means
      you agree to it. Sharing comes with sign-in and has no switch. Delete account (Settings → Need
      Help → Delete Account) stops sharing and erases what was shared. Logging out does not stop it.
    </p>
  </section>

  <section>
    <h2 id="retention">9. Where It Is Kept and for How Long</h2>
    <p>Data is stored with Cloudflare, our hosting provider.</p>
    <div class="doc-grid">
      {retention.map((item) => (
        <div class="doc-card">
          <p class="doc-card-period">{item.period}</p>
          <p class="doc-card-title">{item.label}</p>
          <p>{item.note}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:1rem">There is no other expiry yet: no automatic deletion by age.</p>
  </section>

  <section>
    <h2 id="delete">10. How to Delete Your Account</h2>
    <p>
      In the app: Settings → Need Help → Delete Account. This cancels your plan first. Or without the
      app, by email: see <a href={legalPath(app, 'how-to-delete-account')}>how to delete your
      account</a>.
    </p>
  </section>

  <section>
    <h2 id="children">11. Children</h2>
    <p>{app.name} is not meant for children under 13, and we do not knowingly collect their data.</p>
  </section>

  <section>
    <h2 id="changes">12. Changes</h2>
    <p>If this policy changes, this page changes.</p>
  </section>

  <section>
    <h2 id="contact">13. Contact Us</h2>
    <LegalContact app={app} intro="To ask a question or make a request:" />
  </section>

  <LegalFootLinks app={app} current="privacy-policy" />
</DocLayout>

<style is:global>
  .doc-card-period {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.1;
    color: var(--accent);
  }
</style>
