---
import DocLayout from '../layouts/DocLayout.astro';
import { SUPPORT_EMAIL, appNames } from '../lib/site';
import { organizationSchema, websiteSchema, breadcrumbSchema, webPageSchema } from '../lib/schema';

/**
 * PORTED from the previous build (reviewed for Play Store compliance). Every promise
 * and claim is unchanged. Two edits, both required by WEBSITE_BRIEF.md:
 *   - the invented legal entity "HSR Energy Private Limited" and the Bengaluru postal
 *     address are gone; the studio is "HSR Utility" and has neither.
 *   - "nasheeds" -> "ringtones", matching the app's actual curated ringtone library.
 */

const lastUpdated = 'July 2026';

const description =
  "Privacy policy for Pakiza and Arul by HSR Utility: what data each app collects, the services it uses, how it's protected, and how to delete your account at any time.";

const structuredData = [
  organizationSchema,
  websiteSchema,
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Privacy Policy' }]),
  webPageSchema({
    path: '/privacy',
    name: 'Privacy Policy — Pakiza & Arul | HSR Utility',
    description,
  }),
];

const thirdParties = [
  {
    name: 'Google Sign-In & Google Play Services',
    purpose: 'Sign-in with your Google account and core Android app distribution and functionality.',
    url: 'https://policies.google.com/privacy',
  },
  {
    name: 'Google Firebase (Analytics / GA4, Crashlytics, Performance)',
    purpose: 'Aggregated usage analytics, anonymised crash reports, and performance monitoring.',
    url: 'https://firebase.google.com/support/privacy',
  },
  {
    name: 'PostHog',
    purpose: 'Product analytics — understanding which features are used, in aggregate.',
    url: 'https://posthog.com/privacy',
  },
  {
    name: 'Meta (Facebook) App Events',
    purpose: 'Measurement of advertising and conversion events (enabled only where we run campaigns).',
    url: 'https://www.facebook.com/privacy/policy',
  },
  {
    name: 'PhonePe',
    purpose: 'Processing premium subscription payments and UPI AutoPay mandates.',
    url: 'https://www.phonepe.com/privacy-policy/',
  },
  {
    name: 'Cloudflare',
    purpose: 'Application hosting, content delivery (media), and edge security.',
    url: 'https://www.cloudflare.com/privacypolicy/',
  },
  {
    name: 'Neon',
    purpose: 'Managed PostgreSQL database that stores your account and app state.',
    url: 'https://neon.tech/privacy-policy',
  },
  {
    // Pakiza fetches a display font from Google's CDN on first launch, which
    // discloses the device IP before sign-in. Arul bundles its fonts and makes no
    // such request. Disclosed because it is true today; if the font is ever bundled
    // in Pakiza too, delete this entry.
    name: 'Google Fonts (Pakiza only)',
    purpose:
      'Pakiza loads one display typeface from Google’s font CDN the first time it runs, which involves a request from your device to Google. Arul bundles its fonts and makes no such request.',
    url: 'https://policies.google.com/privacy',
  },
];

/**
 * Permissions. Audited against the MERGED Android manifests of both apps, not the
 * hand-written source manifest — the shipped app declares more than the source file
 * does, because libraries add their own. Every permission the apps' own code
 * actually uses is listed here; the ones libraries pull in are covered by the note
 * under the list rather than each being given a card it does not deserve.
 */
const permissions = [
  {
    name: 'Internet & network state',
    why: 'To load wallpapers, ringtones, and your account data.',
  },
  {
    name: 'Set wallpaper',
    why: 'To apply a wallpaper to your home or lock screen when you choose to.',
  },
  {
    name: 'Modify system settings',
    why: 'To set an audio track as your ringtone when you choose to. We change nothing else.',
  },
  {
    name: 'Notifications',
    why: 'To show the reminders you switch on in Settings. Requested only when you enable them, never at launch. Reminders are generated on your device — nothing is sent to a server to produce them.',
  },
  {
    name: 'Run at startup',
    why: 'To re-arm your scheduled reminders after your phone restarts, so they do not silently stop working.',
  },
  {
    name: 'Photos & media (older Android versions only)',
    why: 'On Android 9 and below, to register a ringtone you choose to set. In Pakiza, also to pick a file from your device when you submit a wallpaper or ringtone. Not used on Android 10 and newer.',
  },
  {
    name: 'Advertising ID',
    why: 'Used by our analytics and measurement partners. You can reset or limit it in your Android settings at any time.',
  },
];

const retention = [
  {
    label: 'Account & app data',
    period: 'Until deleted',
    note: 'Removed promptly upon a valid account deletion request.',
  },
  {
    label: 'Aggregated analytics',
    period: '14 months',
    note: 'Already aggregated — cannot be linked to you after account deletion.',
  },
  {
    label: 'Crash logs',
    period: '90 days',
    note: 'Contains no personal identifiers after account deletion.',
  },
  {
    // Disclosed because it deliberately SURVIVES account deletion. A stable,
    // re-derivable hash of a Google account is pseudonymous personal data, not
    // anonymous data, and leaving it undisclosed is the kind of gap that costs you.
    label: 'One-off trial marker',
    period: 'Indefinite',
    note: 'A one-way hash of your Google account ID, kept so the one-trial-per-person limit cannot be reset by deleting and re-registering. It holds no name, email or reversible data, and cannot be used to identify or contact you.',
  },
];

const uses = [
  'To provide, maintain, and improve the App and its features.',
  'To authenticate your identity and keep your account secure.',
  'To sync your account, preferences, and premium status across devices.',
  'To process premium subscriptions and manage AutoPay mandates.',
  'To review content you submit before it may appear in the App.',
  'To understand usage patterns and improve content and curation.',
  'To measure our advertising and installs.',
  'To diagnose technical issues and fix bugs.',
];

const sharing = [
  'With the service providers listed above, strictly to operate the App on our behalf.',
  'When required by law, or to protect the rights, safety, and security of our users and our service.',
  'As part of a business transfer (such as a merger or acquisition), in which case this policy will continue to apply.',
];

const rights = [
  'Access the personal data we hold about you.',
  'Request correction of inaccurate data.',
  'Request permanent deletion of your account and associated data.',
  'Reset or limit your advertising identifier at any time in your Android settings.',
];
---

<DocLayout
  title="Privacy Policy — Pakiza & Arul"
  heading="Privacy Policy"
  eyebrow="Legal"
  description={description}
  lastUpdated={lastUpdated}
  structuredData={structuredData}
>
  <section>
    <p>
      This Privacy Policy explains how <strong>HSR Utility</strong> ("we", "us", or "our")
      collects, uses, and protects information when you use our Android applications
      <strong>{appNames()}</strong> (each, "the App").
    </p>
    <p>
      Our apps are built by the same team on the same technology and follow the same data
      practices, with the small differences noted where they apply. They differ mainly in the
      content they offer: Pakiza offers Islamic wallpapers and ringtones, Arul offers South
      Indian devotional wallpapers and ringtones. By using any of them, you agree to the
      practices described here.
    </p>
  </section>

  <section>
    <h2 id="collect">1. Information We Collect</h2>

    <h3>Account Information</h3>
    <p>
      You sign in with <strong>Google Sign-In</strong>. We receive your name, email address, and
      Google account identifier, which we use to create and secure your account. We do
      <strong>not</strong> receive your Google profile photo, and we do <strong>not</strong>
      collect your phone number or password.
    </p>

    <h3>Content You Submit</h3>
    <p>
      If you submit content through the App's upload feature — a wallpaper in any of our apps,
      or a ringtone in Pakiza — we store the file you provide and basic details (such as a
      title) so our team can review it before it may appear in the App. You can ask us to remove
      submitted content at any time.
    </p>

    <h3>Referrals</h3>
    <p>
      If you invite someone with your referral link, we record the link between your account and
      theirs so the reward can be credited. On your referrals screen you can see the display name
      or a partly masked email address of people who joined through your link, and they can see
      nothing about you beyond the fact that you referred them.
    </p>

    <h3>Purchase Information</h3>
    <p>
      If you subscribe to a premium plan, payments and UPI AutoPay mandates are processed by
      <strong>PhonePe</strong>. We store your subscription status (for example, active or
      cancelled) and its dates so we can unlock premium features. We do <strong>not</strong>
      store your card, bank, or UPI credentials.
    </p>

    <h3>Usage, Device & Analytics Data</h3>
    <p>
      We use PostHog, Google Analytics for Firebase, and Meta App Events to understand how the
      App is used. This includes your device type, operating system version, language, app
      version, the advertising identifier, and which features you use. We read this in aggregate
      to improve the App, rather than to build a profile of you. Two exceptions worth naming:
      subscription events are reported with an app-installation identifier so a payment can be
      matched to the install that produced it, and PostHog receives a short list of events from
      only a small sample of installations.
    </p>

    <h3>Crash & Performance Data</h3>
    <p>
      We use Firebase Crashlytics and Performance Monitoring to receive anonymised crash and
      performance reports so we can fix bugs. These reports describe the device state at the
      time of an issue and do not include personally identifiable information.
    </p>

    <h3>Install Attribution</h3>
    <p>
      We use the Google Play Install Referrer to understand which campaign, link, or friend's
      referral led you to install the App. This helps us measure our marketing and credit
      referral rewards.
    </p>

    <h3>Reminders</h3>
    <p>
      Reminders are built and scheduled <strong>entirely on your device</strong>. To schedule them
      correctly the App reads your device's time zone locally. There is no push service, no
      server involved, and no location access — nothing about your reminders leaves the phone.
    </p>
  </section>

  <section>
    <h2 id="permissions">2. Device Permissions</h2>
    <p>
      The App requests the permissions below, each for the feature described, and only when you
      choose an action that needs it:
    </p>
    {permissions.map((permission) => (
      <div class="doc-card">
        <p class="doc-card-title">{permission.name}</p>
        <p>{permission.why}</p>
      </div>
    ))}
    <p style="margin-top:1rem">
      Some of the standard libraries we build on — video playback, secure storage, analytics —
      declare additional common Android permissions of their own, such as network state, wake
      lock and advertising identifiers. We do not use them for any purpose beyond what is
      described in this policy.
    </p>
  </section>

  <section>
    <h2 id="use">3. How We Use Your Information</h2>
    <ul>
      {uses.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2 id="third-parties">4. Third-Party Services</h2>
    <p>
      We rely on the following third-party services to operate the App. Each processes data under
      its own privacy policy:
    </p>
    {thirdParties.map((service) => (
      <div class="doc-card">
        <p class="doc-card-title">{service.name}</p>
        <p>{service.purpose}</p>
        <p>
          <a href={service.url} target="_blank" rel="noopener noreferrer">
            {service.url}
          </a>
        </p>
      </div>
    ))}
  </section>

  <section>
    <h2 id="sharing">5. How Your Information Is Shared</h2>
    <p>
      We do <strong>not</strong> sell your personal information, and we do not share the content
      of your account with anyone for their own advertising. We share data only:
    </p>
    <ul>
      {sharing.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2 id="security">6. Data Storage & Security</h2>
    <p>
      Your account and app data are stored in a managed PostgreSQL database (Neon), and media is
      delivered through Cloudflare's infrastructure. We use industry-standard safeguards including
      encrypted connections (HTTPS/TLS) and access controls that restrict data to our backend
      services. No method of transmission or storage is ever 100% secure, but we take reasonable
      steps to protect your information.
    </p>
  </section>

  <section>
    <h2 id="retention">7. Data Retention</h2>
    <div class="doc-grid">
      {retention.map((item) => (
        <div class="doc-card">
          <p class="doc-card-period">{item.period}</p>
          <p class="doc-card-title">{item.label}</p>
          <p>{item.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 id="rights">8. Your Rights</h2>
    <p>You have the right to:</p>
    <ul>
      {rights.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      To exercise any of these rights, please visit our <a href="/delete-account">account
      deletion page</a> or contact us at <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
    </p>
  </section>

  <section>
    <h2 id="children">9. Children's Privacy</h2>
    <p>
      The Apps are not directed at children under the age of 13, and we do not knowingly collect
      personal information from children. If you believe we have inadvertently collected
      information from a child, please contact us and we will delete it promptly.
    </p>
  </section>

  <section>
    <h2 id="consent">10. Consent</h2>
    <p>
      By using Pakiza or Arul, you consent to this Privacy Policy and to the collection and use of
      information as described here. If you do not agree, please discontinue use of the App and,
      if you wish, request deletion of your account.
    </p>
  </section>

  <section>
    <h2 id="changes">11. Changes to This Policy</h2>
    <p>
      We may update this Privacy Policy from time to time. When we do, we will update the "Last
      updated" date at the top of this page. We encourage you to review this policy periodically.
      Continued use of an App after changes constitutes acceptance of the updated policy.
    </p>
  </section>

  <section>
    <h2 id="contact">12. Contact Us</h2>
    <div class="doc-card">
      <p>If you have questions or concerns about this Privacy Policy, please contact us:</p>
      <dl class="doc-meta">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></dd>
        </div>
        <div>
          <dt>Studio</dt>
          <dd>HSR Utility</dd>
        </div>
        <div>
          <dt>Applies to</dt>
          <dd>Pakiza · Arul</dd>
        </div>
      </dl>
    </div>
  </section>

  <nav class="doc-foot-links" aria-label="Related pages">
    <a href="/terms" class="link">Terms of Service</a>
    <a href="/delete-account" class="link">Delete your account</a>
    <a href="/support" class="link">Support &amp; FAQ</a>
  </nav>
</DocLayout>

<style is:global>
  .doc-card-period {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.1;
    color: var(--accent);
  }
</style>
