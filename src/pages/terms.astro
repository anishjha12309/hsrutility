---
import DocLayout from '../layouts/DocLayout.astro';
import LegalContact from '../components/LegalContact.astro';
import LegalFootLinks from '../components/LegalFootLinks.astro';
import { APPS, LEGAL_NAME, SITE_URL, legalPath } from '../lib/site';
import { organizationSchema, websiteSchema, breadcrumbSchema, webPageSchema } from '../lib/schema';

/**
 * The WEBSITE's terms. Re-scoped from the studio-wide app terms on 2026-08-20, when
 * each app got its own set under its own slug.
 *
 * Everything about accounts, subscriptions, billing and submissions moved to those —
 * none of it happens here. What is left is what a brochure site actually needs, and
 * it stays short on purpose: padding it back out with clauses about services this
 * site does not offer is how the app terms and these two drift apart.
 */
const host = SITE_URL.replace(/^https?:\/\//, '');
const lastUpdated = 'August 2026';

const description = `Terms & Conditions for the ${host} website: permitted use, intellectual property, third-party links and liability. Each of our Android apps has its own separate terms.`;

const structuredData = [
  organizationSchema,
  websiteSchema,
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Terms & Conditions' }]),
  webPageSchema({
    path: '/terms',
    name: 'Terms & Conditions — hsrutility.com | HSR Utility',
    description,
  }),
];

const permitted = [
  'Reading about our apps and what they do.',
  'Following our links to the Google Play Store to install an app.',
  'Reading and printing our legal documents for your own reference.',
  'Contacting us for support, or about a copyright or privacy matter.',
];

const prohibited = [
  'Use the site for anything unlawful, or in breach of any applicable regulation.',
  'Copy, republish or mirror its text, design or code as your own.',
  'Scrape it at a volume that burdens it, or run automated tools against it.',
  'Attempt to gain unauthorised access to it, or to probe or disrupt the systems behind it.',
  'Present yourself as us, or imply an association or endorsement that does not exist.',
];
---

<DocLayout
  title="Terms & Conditions — hsrutility.com"
  heading="Terms &amp; Conditions"
  eyebrow="Website — legal"
  description={description}
  lastUpdated={lastUpdated}
  intro={`These terms cover the ${host} website. Using one of our Android apps is governed by that app's own terms instead — the links are at the bottom of this page.`}
  structuredData={structuredData}
>
  <section>
    <p>
      These Terms &amp; Conditions govern your use of the website at <strong>{host}</strong>, operated
      by <strong>{LEGAL_NAME}</strong>, which trades as HSR Utility ("we", "us" or "our"). By using
      the site you accept them. If you do not, please stop using the site.
    </p>
    <div class="doc-card">
      <p class="doc-card-title">These are not your app's terms</p>
      <p>
        Accounts, premium subscriptions, billing, refunds and content submissions all belong to the
        apps, and each app has its own Terms &amp; Conditions covering them:
        {APPS.map((app, i) => (
          <>
            {i > 0 && ' · '}
            <a href={legalPath(app, 'terms')}>{app.name}</a>
          </>
        ))}.
      </p>
    </div>
  </section>

  <section>
    <h2 id="site">1. What This Website Is</h2>
    <p>
      A brochure for our Android apps and the home for their legal documents. There is nothing to sign
      up for here, nothing to buy and no account to hold — all of that happens inside an app, if at all.
    </p>
  </section>

  <section>
    <h2 id="use">2. Using the Site</h2>
    <h3>What you may do</h3>
    <ul>{permitted.map((item) => <li>{item}</li>)}</ul>

    <h3>What you may not do</h3>
    <ul>{prohibited.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section>
    <h2 id="ip">3. Intellectual Property</h2>
    <p>
      The name HSR Utility, our app names and logos, and this site's text, design, artwork and code
      belong to us or are licensed to us. You may read the site and print pages for your own reference;
      that is the whole licence granted here. Reproducing its content or design elsewhere, or using our
      names in a way that implies endorsement, requires our written permission.
    </p>
    <p>
      Google Play and the Google Play logo are trademarks of Google LLC. Other names here belong to
      their owners and appear because our apps rely on those services, not as endorsements.
    </p>
    <p>
      If you believe something here or in one of our apps infringes your copyright, tell us at the
      address below — name the app and identify the work — and we will look into it.
    </p>
  </section>

  <section>
    <h2 id="links">4. Links to Other Sites</h2>
    <p>
      We link out to the Google Play Store and to the privacy policies of the services our apps use.
      Those sites are not ours: we do not control them, are not responsible for them, and a link is not
      an endorsement. Once you leave, their terms and privacy policy apply instead of ours.
    </p>
  </section>

  <section>
    <h2 id="availability">5. Availability &amp; Accuracy</h2>
    <p>
      The site is provided <strong>"as is" and "as available"</strong>. We keep it as accurate as we
      can, but apps change and a page may briefly describe a feature as it was. Nothing here is a
      warranty or a commitment about how an app behaves — the app's own terms govern that. We do not
      promise the site will be uninterrupted or error-free, and may change or remove any page.
    </p>
  </section>

  <section>
    <h2 id="liability">6. Limitation of Liability</h2>
    <p>
      To the fullest extent the law permits, {LEGAL_NAME} and its team will not be liable for any
      indirect, incidental, special, consequential or punitive damages, or for loss of data, profits
      or goodwill, arising from your use of this website or from your inability to use it. Nothing
      here limits liability that cannot be limited under applicable law.
    </p>
  </section>

  <section>
    <h2 id="changes">7. Changes to These Terms</h2>
    <p>
      We may update these terms. The "Last updated" date moves when we do, the new version applies from
      publication, and continuing to use the site means you accept it.
    </p>
  </section>

  <section>
    <h2 id="law">8. Governing Law &amp; Severability</h2>
    <p>
      These terms are governed by the laws of India, and any dispute is subject to the exclusive
      jurisdiction of the courts of Mumbai, Maharashtra. If any provision is unenforceable, the rest
      stays in force and that part is read as narrowly as needed to give it effect.
    </p>
    <p>
      Together with our <a href="/privacy-policy">Privacy Policy</a> and
      <a href="/cookie-policy">Cookie Policy</a>, these terms are the entire agreement between you
      and us in respect of this website.
    </p>
  </section>

  <section>
    <h2 id="contact">9. Contact Us</h2>
    <LegalContact
      appliesTo={`The ${host} website`}
      intro="If you have a question about these terms, please contact us:"
    />
  </section>

  <LegalFootLinks
    links={[
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'Cookie Policy', href: '/cookie-policy' },
      { label: 'Refund Policy', href: '/refund-policy' },
      { label: 'Support & FAQ', href: '/support' },
    ]}
  />
</DocLayout>
