---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { ORG_DESCRIPTION, appNames, type AppFact } from '../lib/site';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Share-card image, site-relative. Override per page only if a bespoke card exists. */
  image?: string;
  /** JSON-LD objects for this page. Built with the helpers in ../lib/schema.ts */
  structuredData?: object[];
  /**
   * Set on every page under /<app-slug>/ and nowhere else. It swaps the nav and
   * footer for that app's own, and keeps the other app's name out of the share-card
   * alt text — which otherwise names both apps on all of them.
   */
  scope?: AppFact;
}

const {
  title,
  description = ORG_DESCRIPTION,
  image,
  structuredData = [],
  scope,
} = Astro.props;

// An app with its own share card uses it on every page of its sub-site.
const shareImage = image ?? scope?.ogImage ?? '/og.png';

const fullTitle = `${title} | HSR Utility`;

// Astro.site comes from `site` in astro.config.mjs. Both of these resolve to absolute
// URLs — required for canonical and og:image (a relative og:image is ignored by scrapers).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(shareImage, Astro.site);

// Named apps in the alt text follow the scope. On /pakiza/* it must not say Arul.
const imageAlt = scope?.ogImage && !image
  ? `${scope.name}: ${scope.tagline}`
  : scope
  ? `HSR Utility — the indie Android studio behind ${scope.name}`
  : `HSR Utility — an indie Android studio behind the apps ${appNames()}`;
---

<!doctype html>
<html lang="en" data-app={scope?.slug}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {/*
      No-flash theme. Must be `is:inline` and must stay in <head> above the body:
      a bundled module script is deferred, which would paint the dark default first
      and then snap to light. This also stamps `.motion-ok`, which is what unhides
      the animated start states in global.css — so if JS is off or the visitor asks
      for reduced motion, every element renders in its final position.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var pref = 'auto';
        try {
          pref = localStorage.getItem('hsr-theme') || 'auto';
        } catch (e) {
          /* Private mode / storage blocked — 'auto' is the right fallback. */
        }
        var resolved =
          pref === 'auto'
            ? window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark'
            : pref;
        root.dataset.theme = resolved;
        root.dataset.themePref = pref;

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion-ok');
        }
      })();
    </script>

    {/* SVG covers modern browsers; the PNG covers iOS home-screen, which ignores SVG. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={scope?.slug === 'dailypassbook' ? '#1A1B2E' : '#161613'} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={scope?.slug === 'dailypassbook' ? '#F8F9FC' : '#F0EFE3'} media="(prefers-color-scheme: light)" />

    {/*
      Only the faces that paint above the fold: the serif headline is the LCP
      element on every page, the sans is the body. Preloading the mono or the
      serif italic as well would just contend for bandwidth with the LCP on a
      throttled connection (the italic accent word swaps in a frame later,
      metric-matched, so nothing moves).
    */}
    {scope?.slug === 'dailypassbook' ? (
      <>
        <link rel="preload" as="font" type="font/woff" href="/fonts/inter-700-latin.woff" crossorigin />
        <link rel="preload" as="font" type="font/woff" href="/fonts/inter-400-latin.woff" crossorigin />
      </>
    ) : (
      <>
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href="/fonts/instrument-serif-latin-400-normal.woff2"
          crossorigin
        />
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href="/fonts/instrument-sans-var-latin.woff2"
          crossorigin
        />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HSR Utility" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={imageAlt}
    />
    <meta property="og:locale" content="en_US" />

    {/* X never migrated off the twitter:* namespace; without an explicit card type
        it renders a small thumbnail instead of the large one. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta
      name="twitter:image:alt"
      content={imageAlt}
    />

    {/*
      is:inline is explicit here: these are data blocks, not code to bundle.

      Fenced against Cloudflare's Email Address Obfuscation like every other address
      on the site (see components/Email.astro), with a LITERAL comment — routing it
      through set:html gets it escaped, which ships visible markup and fences nothing.
      Script bodies are not HTML text and should be left alone by the obfuscator
      anyway; this is belt and braces, because the Organization schema carries the
      support address and a rewritten JSON-LD block is invalid JSON, which fails
      silently and takes the whole entity down with it.
    */}
    <!--email_off-->
    {structuredData.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
    <!--/email_off-->

    <ClientRouter />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Navbar scope={scope} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer scope={scope} />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% -140%;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    border-radius: 0 0 0.75rem 0.75rem;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: translate 0.2s ease;
  }

  .skip-link:focus-visible {
    translate: -50% 0;
  }

  /* The <main> is focus target for the skip link but must not show a ring of its own. */
  main:focus {
    outline: none;
  }
</style>
